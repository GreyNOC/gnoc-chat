                                                + (["--approve"] + args if args and not args[0].startswith("-") else ["--pending"]))),
        "replies": lambda: sys.exit(passthrough([sys.executable, os.path.join(WS, "scripts/h1-replies.py")] + (args or ["list"]))),
        "models": lambda: sys.exit(passthrough([sys.executable, os.path.join(WS, "scripts/gnoc-models.py")] + args)),
        "ship": lambda: sys.exit(passthrough([sys.executable, os.path.join(WS, "scripts/ship-pipeline.py")] + args)),
        "oss": lambda: do_oss(args),
        "start": lambda: do_start(args),
        "video": lambda: sys.exit(do_video(args)),
        "gpus": lambda: sys.exit(do_gpus(args)),
        "export": lambda: sys.exit(do_export(args)),
        "soak": lambda: sys.exit(do_soak(args)),
        "discord": lambda: sys.exit(passthrough([sys.executable,
                                                 os.path.join(WS, "scripts/gnoc_discord.py")] + args)),  # DISCORD
    }
    if cmd in ("-h", "--help", "help") or cmd not in table:
        if cmd not in ("-h", "--help", "help"):
            print(red(f"unknown command: {cmd}"), file=sys.stderr)
        print(QUICK_HELP + "\nEVERY COMMAND\n" + __doc__)
        return 0 if cmd in ("-h", "--help", "help") else 2
    table[cmd]()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
