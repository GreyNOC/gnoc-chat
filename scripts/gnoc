    import llm_endpoints  # role -> laptop or linked desktop Ollama, with fallback
    _CHAT = llm_endpoints.resolve("chat")
except Exception:
    _CHAT = ("http://" + os.environ.get("GNOC_LOCAL_OLLAMA", "127.0.0.1:11434") + "/api/chat", None, "local")
