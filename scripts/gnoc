#!/usr/bin/env python3
"""gnoc - one-screen CLI dashboard and control panel for the hunt workspace.

  gnoc                      status screen (default): the dashboard panels as one frame on a terminal,
                            plain text when piped (or GNOC_PLAIN=1)
  gnoc start auto hunt [<target>]   RETIRED 2026-11-02. There is no unattended hunter any more: hunting
                            lives inside a `gnoc chat` session and stops when you close it. Open
                            `gnoc chat` and ask it to hunt; it orchestrates lanes on request. The gate:
                            `python3 scripts/gnoc_session.py status`.
  gnoc chair                the captain's chair. NOTE its orch-bot levers (tick speed, auto mode, brain)
                            are inert since the bot was retired 2026-11-02; the rest still works
                            (oss-bot read-only, final gate, ALL STOP, pivot, kill lane, triage/review)
  gnoc dash [--view simple|technical] [--theme neon|contrast|mono] [--demo] [--classic]
                            the redesigned live dashboard: a plain-language SIMPLE view by default
                            (status in one sentence, what it's doing, what's been found, is the team
                            ok, recent activity translated out of jargon, what needs you) with a
                            TECHNICAL view a keypress away (v or Tab, remembered between runs) showing
                            everything `gnoc watch` does, laid out denser. --demo replaces real
                            program/host/report names with stable fake ones (Ctrl-D toggles it live) so
                            a screenshot is safe to share. --classic runs the original `gnoc watch`.
                            See scripts/GNOC-DASHBOARD.md for the full key/theme reference.
  gnoc watch [secs] [--no-anim]  the original live dashboard (gnoc dash is the newer one): GreyNOC header (clock, uptime, AUTO-HUNT / brain / STOP),
                            HUNT, ORCH BRAIN, GPU, DESKTOP, MODEL LAB, INBOX, SYSTEM and OUTCOMES panels
                            that reflow from 80x24 to wide screens, and a command box at the bottom (type
                            any gnoc command, !shell, q to quit; PgUp/PgDn scroll the output pane). Data is
                            read on background threads, so a slow Ollama or pm2 never freezes it. --no-anim
                            (or no TTY) = the plain status every [secs] (default 10). Use this over an SSH
                            session (e.g. from the linked Windows desktop) when the web control panel at
                            127.0.0.1:8787 isn't reachable - it carries the same desktop link status,
                            traffic and chat, just in the terminal.
  gnoc dchat ["question"] [--model <name>]   chat directly with whatever model is loaded on the linked
                            desktop (no hunt-bot system prompt - raw, for testing a model). Bare `dchat`
                            in gnoc watch opens an interactive REPL; `dchat reset` clears its history.
  gnoc code [bugbounty|website|<path>] [--on desktop] [--model <name>]   an agentic coding session
                            (like this CLI) in the workspace or the your-site.example website repo: real
                            file read/write/edit and bash via OpenCode's default agent, backed by a
                            local model, with its normal approval prompts (never --auto). Defaults to
                            the workspace and whatever model+host the hunter role points at.
  gnoc gpus                 which model each role resolves to, which llm hosts answer and what they
                            have loaded, and the local GPUs with busy percent and VRAM
  gnoc pair <address> <key> use another computer's GPU through its gnoc engine (`gnoc-engine share on` there
                            prints this line; no Ollama needed)
  gnoc soak [name] [-f prompts.txt] [-t secs]   drive the chat bot with real prompts and flag anything
                            that looks like a defect rather than an answer (the battery that found the
                            2026-10-25 fixes). Rows land in <name>.jsonl in the current directory.
  gnoc-office               a separate full-screen office (~/.local/bin/gnoc-office -> scripts/gnoc-office.py): the hunt workspace
                            as an office, one real pm2 process per worker desk, chat bubbles pulled
                            from the real logs, feed/treat a worker, a work-harder slider wired to
                            orch-bot's real tick interval. Run it directly; see its own --help.
  gnoc gateway [check|run|install|status]   drive gnoc from Telegram, Slack, Signal or email (owners only,
                            approvals in the same chat, redacted); scripts/gnoc_gateway
  gnoc discord [--check|--once <query>]   a READ-ONLY Discord bot so the team can query the hunt from
                            chat: !hunt status|needs|reports|lanes|outcomes|line|company|econ|gpus and
                            !ask <question> (one agent turn). It never opens a hunt session, so it
                            cannot hunt; approvals refuse; every answer is put through the dashboard's
                            --demo name substitution before it leaves. Needs DISCORD_BOT_TOKEN and
                            GNOC_DISCORD_USERS in secrets.env; --check verifies both and self-tests the
                            scrub. See scripts/GNOC-DISCORD.md
  gnoc train <curriculum.txt> [--dry]   teach gnoc chat: run a curriculum (/program <h> lines + questions) through
                            the real agent with a private session and goal, so its reflections land in the real lesson
                            book and trajectory log; approval-gated actions are refused (scripts/gnoc_train.py)
  gnoc export trajectories --format sharegpt|openai [--since YYYY-MM-DD] [--out PATH] [--no-redact]
                            the logged tool turns as training data, redacted by default (secrets, home paths,
                            IPs and hostnames off the allowlist); gnoc export batch <prompts.jsonl> --out DIR
                            runs prompts headless, every gated action held (scripts/gnoc_trajectories.py)
  gnoc intel fetch|extract|index|program <h>|status [--dry] [--since D]   intake public technique, disclosed
                            reports and report style into patterns/intel + research/style (scripts/GNOC-INTEL.md)
  gnoc oracle status <p>|verify <p> <id> <capture>...|phase <class> [p]|banner <p>|classes   hash-committed
                            terminal oracles, sealed captures, per-class release phases (scripts/GNOC-ORACLE.md)
  gnoc company status|retro|journal [n]|manage   the bots' company: payroll, bounties, P&L, retro (scripts/GNOC-COMPANY.md)
  gnoc econ status|audit|bet|bounty|settle   the proof market ledger (scripts/gnoc_economy.py)
  gnoc line open|advance|market|status|brief ...   THE LINE: nine-station work orders (scripts/gnoc_line.py)
  gnoc lab <args>           Model Lab: passthrough to python3 scripts/model-lab/lab.py <args>
                            (bench <model> [--suite quick|full] | serve [--port 8765] | export <run|latest> |
                            list | compare <run> <run>...); in gnoc watch, bench and serve run detached
  gnoc leads [--once|--view technical]  LEAD LAB: live rescue-pipeline board, what is tested now (scripts/gnoc-leads.py)
  gnoc sandbox <args>       emulated surfaces: passthrough to python3 scripts/workbench/sandbox.py <args>
                            (oss | evm [test|guard] | electron | ext | ls | down all|<program> [name] | selftest);
                            loopback-only labs under targets/<program>/labs/ (scripts/workbench/README-sandbox.md)
  gnoc droid <args>         Android app workbench: passthrough to python3 scripts/workbench/droid.py <args>
                            (setup | intake <p> <pkg|apk> | static <p> <pkg> | up | run <p> <pkg> [--minutes N]
                            | status | down | report <p> <pkg>); in-scope app rows only (scripts/workbench/README.md)
  gnoc menu               interactive numbered menu
  gnoc stop | resume        set / clear the global STOP flag (.claude/state/hunt-loop/STOP)
  gnoc lock <handle>        pin the global LOCK (Claude sessions without their own LOCK.<sid> follow it;
                            the orch bot follows AUTO-HUNT, use gnoc pivot to switch what it hunts)
  gnoc lock <handle> --sid <session_id>   pin one session
  gnoc unlock [--sid <id>]  clear the global (or one session's) lock; an 8-char id prefix is enough
  gnoc lane <program> <lane-dir> <brief.md> <probes.txt> [round]
                            start an OpenCode lane in the background (scripts/opencode-lane.sh)
  gnoc lanes                running OpenCode drivers + last lines of each log
  gnoc kill-lane <pid>      stop one OpenCode driver
  gnoc outcomes [n]         last n outcome lines (default 15)
  gnoc reports              rebuild and print the report pipeline summary
  gnoc needs                open NEEDS from HANDOFF-CURRENT.md
  gnoc handoff              the LOOP STATE block of HANDOFF-CURRENT.md
  gnoc fleet [args]         pass-through to scripts/hunt-fleet-launch.sh (default --list)
  gnoc hq <args>            pass-through to scripts/hq
  gnoc svc [restart <name>] pm2 services (ollama-oc, tunnel, ...)
  gnoc ship <draft-dir> [--llm]   run every pre-filing gate (local first; --llm adds the
                            kill pass + repro check, only when the draft changed)
  gnoc ship <dir> --fix [--llm]  auto-repair text blockers with a headless writer, re-gate (2 rounds)
  gnoc ship --all [--llm]   every changed draft;  gnoc ship --watch [secs] [--llm]
  gnoc orch [status|queue|inbox|log|pause|resume]   the no-Claude orchestrator bot (pm2 orch-bot);
                            pause/resume = the same global STOP flag as gnoc stop/resume
  gnoc orch auto [program|target|off|plan [program]]   bot hunts on its own; "target" = bot picks the program
                            (no name = the newest valid lock; target keeps the current program until it is done)
  gnoc orch brain [on|off|why [n]|test|snapshot]   local-model decision layer (test = dry run, executes nothing)
  gnoc orch speed [1-5]     orch-bot's tick speed, 1=120s slowest .. 5=20s fastest; no number = show the current one
  gnoc oss [status|plan|leads|pause|resume [--ack-incident]|drain|undrain|run ...|mark ...]   one front door to
                            scripts/oss-bot/bot.py (the no-Claude background scanner, pm2 oss-bot); default: status.
                            An "INCIDENT " pause (a scope-proxy bypass caught itself) needs --ack-incident to clear.
  gnoc gate [claude|human|queue|pass <dir> [note]|fail <dir> <why>]   who runs the final gates (kill pass + repro
                            check): Claude, or your own QAQC; pass/fail binds your verdict to the draft's current bytes
  gnoc approve [<draft-dir>]  no dir = READY drafts waiting for you; a dir = ONE-TAP filing (paid or VDP): shows the
                            filing, one confirmation ('verified' where the policy wants your own check), gates, files
  gnoc replies [sync|list|show <n>|sent <n>|redo <n> [guidance]]   drafted replies to triager messages (never sent
                            by the bot: you post them on HackerOne, then mark them sent)
  gnoc models [search|files|pull|use|test|rm]   clone Hugging Face GGUF models into the local model server and
                            give them a role (brain, chat, hunter); gnoc models help shows every subcommand
  gnoc engine [install|start|stop|pull|list|rm|import-ollama]   gnoc's own model server (llama.cpp underneath):
                            the Ollama calls gnoc makes, without Ollama; gnoc engine help
  gnoc chat [flags] ["message"]   the two-GPU hunt agent: talk to it in plain English. Lead model on the desktop GPU,
                            worker on the laptop GPU. It reads/edits files, runs scope-gated shell and HTTP probes,
                            searches past hunts, drives gnoc and the background bot, launches Claude workers, and
                            hunts continuously. Writes, non-read-only shell, non-GET HTTP and Claude workers ask first.
                            deepcode-style flags (the colorful REPL and banner stay):
                            -p|--prompt <text> (submit on launch, stay in the REPL), -x|--exec (one prompt,
                            non-interactive), -r|--resume [id] (bare -r = session picker), -f|--fork [id]
                            (bare -f = the most recent), -l|--last (same as -c), -v|--version,
                            cat log | gnoc chat -x -p "explain this" (piped stdin rides along as context)
                            Slash commands (/help in the REPL): /hunt [program] [goal], /bot, /deep <request>, /gpus,
                            /lead /worker <model[@desktop]> (a cloud model works too: /model deepseek or
                            /model deepseek-chat@deepseek; bare /model picks from local + cloud), /program <h>,
                            /collab [status|refresh|import <dir|file>] (a partner handoff IS the scope), /auto
                            on|off, /jobs, /stophunt, /new /reset,
                            /fork /continue /resume /sessions, /raw (reasoning display), /exit,
                            /mode swe|design|review (senior software engineer, website designer, proving code
                            reviewer) and the team() tool: parallel specialist bots (architect, backend,
                            frontend, designer, reviewer, tester, security, researcher, docs) with the lead
                            implementing, /plan [request] (deepcode-style plan mode: propose, show the plan
                            panel, enter = implement · e = edit · q = keep; /plan on pins it, the active plan
                            rides the prompt bar), /init (workspace setup: GNOC.md + gchat.md on first entry,
                            /init project <name> scaffolds a new project), /work <task> (long-horizon
                            autonomous task completion: plan, then step after step across turns until done),
                            /effort low|medium|high|max (reasoning depth + tool-step budget),
                            /cd <dir|program> (move its working dir, starts a gchat.md session there; it can do
                            this itself),
                            /simple <q> (the old read-only status Q&A), /model /route /clone /bots,
                            /hf clone <owner/repo|huggingface url> (clone a Hugging Face model and talk to it;
                            max 3 cloned bots per GPU, the least-used one without a role is removed).
                            Set roles for good: gnoc models use lead|worker <model> [--on desktop]
  gnoc chat --repo <path|url|owner/repo|website> [flags]   the same agent in any repo: a folder on disk, or a
                            public remote cloned once (shallow, into ~/.gnoc/repos) and opened there; reads its
                            GNOC.md / CLAUDE.md, analyzes and fixes code, runs its tests (website = your-site.example).
                            A bare `gnoc chat` already opens in the directory you launch it from; --repo overrides
                            that, `/repo off` goes back to the hunt workspace
  gnoc chat --offline [...] local GPUs only: no cloud model is ever called (cloud workers off, ship gates run
                            locally, Hugging Face downloads refused); also /offline on and GNOC_OFFLINE=1
  gnoc chat -s-p [...]      skip permissions for this launch (also --skip-permissions): writes, shell, non-GET HTTP,
                            Claude workers and live-repo edits run without asking. Scope gate, deny lists, secret
                            guard and the no-submit rule still hold. Combines with --repo and a one-shot message.
  gnoc chat -c [...]        continue the last conversation (every plain launch starts a new one: program clear,
                            unlimited steps, auto mode); -l/--last is
                            the same flag, -r <id> resumes a specific saved conversation, -f <id> forks one
  gnoc chat --plain [...]  just talk to the bot like a normal assistant: no program, scope or hunt setup needed
                            (also /plain on|off in the REPL). The hunt agent is the default without it.
  gnoc collab [status|import [dir|file]|refresh <handle>]
                            collaborator engagements: the partner's INITIAL HANDOFF document is the scope, not a
                            bug-bounty program. Opening `gnoc chat` in a project that has HANDOFF*.md (or
                            kickoff/onboarding, SCOPE/AUTHORIZATION/ROE/SOW paperwork - Markdown, text, PDF,
                            DOCX) imports it automatically into targets/collab-<project>/. `import` does it for
                            a named dir, `refresh` re-reads the handoff after an edit. Inside chat: /collab.
  gnoc graph [overview|stats|assets|coverage|nodes|todos|traces|traffic|evidence|findings|retest|retests|rules|snapshot|snapshots|diff|path|lineage|draft|approvals|export|programs] [program] [query]
                            the ARTEX-style dual graph: the global asset graph (hosts/endpoints deduplicated
                            and program-associated) plus the per-program exploration graph (goal/intent/fact/
                            finding nodes anchored to assets), coverage and untested assets, durable planning
                            todos with worker leases, searchable worker traces, deduplicated evidence and the
                            findings lifecycle. `snapshot` freezes the in-scope set, `diff` shows the attack
                            surface moving (added/removed/coverage-changed), `path a b` walks the shortest
                            chain between two nodes and `lineage <node>` lists everything that led to it. `traffic` is every
                            captured exchange: list/search by host, method or status, `show <id>` for the bytes,
                            `purge` to clear. `stats` prints the program's dashboard numbers; `retest`/`retests` schedule and read
                            re-tests of confirmed findings; `rules` lists the operator's bounded approval rules
                            (`gnoc graph rules <program> add <action> <args-glob> [--uses N] [--ttl SECS]`).
                            `gnoc graph export [program] [--out PATH] [--open]` writes the visual cockpit: one
                            self-contained HTML page (graph, coverage, findings, todos, approvals), no network,
                            no CDN. `gnoc graph draft <program> <finding_id>` assembles a REPORT-FORMAT report
                            draft (report.md + GATES.md + the cited raw captures) for a CONFIRMED finding: the
                            PoC is built from the evidence bytes, Summary/Impact/CVSS/CWE come from labelled
                            lines in the finding body. It files nothing. Inside chat: /graph, /graph draft <id>.
  gnoc mcp [list|tools <server>|call <server> <tool> ['<json>']|add <name> --stdio CMD [args...]|--url URL [--transport http|sse]|remove <name>]
                            the MCP client: configured servers in .claude/state/mcp.json, their tools and the
                            call path, over stdio, streamable HTTP or the legacy SSE transport (Burp's MCP
                            extension). `list` probes each server; `tools` prints the schema summary; `call`
                            runs one tool and prints its text. Inside chat: the `mcp` tool.
  gnoc approvals [list [state]|show <id>|approve <id> [reason]|deny <id> [reason]]
                            the intercept approval queue: a non-interactive turn that needs the user's yes
                            records the exact call instead of silently refusing. Approving makes that exact
                            call runnable once until it expires; denying is final. Inside chat: /approvals,
                            /approve <id>, /deny <id>.
  gnoc agents               arrow-key picker of sub-agents (fan-out bots, workers): their live log and whole chat;
                            run it in a second terminal while gnoc chat hunts
  gnoc video [list|course <belt>|track <id>|marketing <clip>|render <board.json>|evidence <sub...>|outputs]
                            the video system from here: list what the builder knows, build + render a belt's course
                            video, a track or a marketing clip (website repo scripts/video/), render any storyboard,
                            record evidence clips (scripts/evidence-video.py), list what's in ~/Downloads. Trailing
                            args pass through untouched (engine flags after `--`), e.g.
                            `gnoc video course white --quick -- --formats mp4`. Output lands in ~/Downloads;
                            gnoc video help shows every form
  gnoc qaqc [--quick|--json] QA/QC battery for the chat harness: parse + lint + import + tool-registry audit +
                            unit tests over scripts/gnoc and scripts/gnoc_*.py; run after another session's edits
  gnoc link [add <name> <user@ip> | test | list | remove]   link another Linux machine on this LAN; bare
                            `gnoc link` prints the block to paste on that machine and walks you through it
  gnoc chat --simple ["q"]  the old read-only status Q&A (one local model, no tools)
  gnoc split [status|up [model]|down|restart-remote]  ONE model across BOTH GPUs (laptop + desktop over llama.cpp RPC):
                            up loads Qwen3.6-35B split ~2:1 desktop:laptop; gnoc chat then runs lead AND worker
                            on it. Desktop side once: scripts/desktop-link/rpc-desktop.ps1. The phone joins as a
                            third RPC device when it answers (gnoc phone); `up <model> --no-phone` leaves it out
  gnoc phone nas [mount|umount|status|speed]   the phone's 462 GB of shared storage as a local folder
                            (~/phone-nas) over the same USB ssh link, via rclone's sftp backend. Mounting leaves a
                            flag the supervisor watches, so it comes back after a replug or a phone reboot.
  gnoc phone [status|up|down|setup|revive|log [n]]  the Android phone over USB (adb): up = the phone-link supervisor
                            (pm2) keeping the adb forwards (phone Ollama -> :11441, phone rpc-server -> :50053,
                            phone sshd -> :8022) and REVIVING the phone's serve loop when Android kills Termux
                            under it; revive = force that repair now; log = tail the phone's serve log; setup = push the
                            one-time Termux script; it shows as a SERVER ROOM rack in gnoc-office
  gnoc inbox                verified reports with proof of exploit ONLY (pipeline READY or QA-READY), with POE paths
  gnoc inbox log [n] [old]  bot activity notifications (numbered; read/del act on these)
  gnoc inbox all [--all]    every report by stage (ready/draft/held/submitted) with paths + zips
  gnoc inbox read|unread|del <N|N-M|N,M|read|all>   mark read, or remove the notification only (never the report or its files)
  gnoc prune [days] [--yes] [--include-submitted]   delete report dirs and zips untouched for N days (default 30)
  gnoc pivot [program]      switch the hunt: no name = park the current program, bot picks the next best;
                            a name = hunt that program now (intake first if new); pivot back to unpark
  gnoc unpark [all|<program> ...] [--reset]   list parked programs, or clear the parked flag (all, or named);
                            --reset also clears "exhausted" so a fully swept program is ranked again
  gnoc orch report          auto-hunt progress per program: swept/total, hits, leads, speed, ETA
  gnoc orch rank            how auto-target ranks the programs (VDP + paid interleaved; bans/exhausted skipped)
  gnoc orch intake <handle> pull a new H1 program: scope + policy, ban check, passive host map
  gnoc orch add <program> <lane> <brief.md> <probes.txt> [round]   queue an OpenCode lane
  gnoc zip <target|-a> [all|today|yesterday|YYYY-MM-DD] [draft|qa|submit]   every report (+evidence) of a target,
                            or -a all targets, into ONE combined zip
  gnoc zip reports [today|yesterday|all|YYYY-MM-DD] [draft|qa|submit]   every matching report across ALL programs,
                            each zipped into its OWN bundle (not combined) and copied to ~/Downloads
  gnoc zip --list <target|-a> [all|today|yesterday|YYYY-MM-DD] [draft|qa|submit]   dry run, print what either
                            mode above would bundle, write nothing
  gnoc bundle <draft-dir>   zip the report (internal header lines stripped) + every file in its dir except our
                            secrets, incl. GATES.md/FORM.md (reports/bundles/<program>/); review before attaching
  gnoc mine [program] [--refresh]   our own H1 reports (Hacker API, cached 20 min)
  gnoc dupcheck <draft-dir>  did WE already file this? CLEAR / POSSIBLE / DUPLICATE (fails closed)
  gnoc submit --list        staged filing packages (api vs web-form)
  gnoc submit <report.md|dir> [--program h] [h1-submit args]   DRY RUN only
  gnoc submit <...> --send  real H1 submit: needs the approval file, typing the
                            handle, then typing 'submit' at the payload prompt
  gnoc chat, then /file <program/slug> [--dry-run]   file one draft from the REPL: gates, the exact payload, FILE <slug>

Nothing here fires a probe. Only `gnoc submit --send` (three confirmations) and chat's typed /file can file.
"""
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import gnoc_compat  # noqa: E402  (native Windows: fcntl / signals / console before anything else imports)
import gnoc_edition  # noqa: E402  (this machine's settings, .claude/state/orch/machine.json, before any env read)
gnoc_compat.install()
import contextlib  # noqa: E402
import json  # noqa: E402
import re  # noqa: E402
import shutil  # noqa: E402
import subprocess  # noqa: E402
import threading  # noqa: E402
import time
from datetime import datetime, timezone

WS = os.environ.get("GNOC_WS", (os.environ.get("GNOC_WORKSPACE") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
STATE = os.path.join(WS, ".claude/state/hunt-loop")
OC_STATE = os.path.join(WS, ".claude/state/opencode")
HANDOFF = os.path.join(WS, "HANDOFF-CURRENT.md")

TTY = sys.stdout.isatty() or os.environ.get("GNOC_FORCE_COLOR") == "1"


def c(code, s):
    return f"\033[{code}m{s}\033[0m" if TTY else str(s)


def bold(s): return c("1", s)
def dim(s): return c("2", s)
# Parrot OS terminal palette (scripts/gnoc_theme.py): bright red, green, yellow, and blue where cyan used to be
def red(s): return c("91", s)
def green(s): return c("92", s)
def yellow(s): return c("93", s)
def cyan(s): return c("94", s)


def sh(cmd, timeout=20):
    try:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True,
                           timeout=timeout, cwd=WS)
        return r.returncode, r.stdout, r.stderr
    except Exception as e:  # timeout or missing binary
        return 1, "", str(e)


def read(path, default=""):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return default


def ago(ts):
    secs = int(time.time() - ts)
    if secs < 90:
        return f"{secs}s ago"
    if secs < 5400:
        return f"{secs // 60}m ago"
    if secs < 172800:
        return f"{secs // 3600}h ago"
    return f"{secs // 86400}d ago"


def header(title):
    print(bold(cyan(f"== {title} ")) + dim("=" * max(0, 60 - len(title))))


def pid_alive(pid):
    """True only for a live process. os.kill(pid, 0) also succeeds on a zombie, and orch-bot's finished jobs sit as
    zombies until its next tick reaps them, so read the state letter from /proc instead."""
    try:
        with open(f"/proc/{int(pid)}/stat") as f:
            return f.read().rsplit(")", 1)[1].split()[0] not in ("Z", "X")
    except (OSError, ValueError, TypeError, IndexError):
        return False


def has_scope(prog):
    return bool(prog) and os.path.isfile(os.path.join(WS, "targets", prog, "SCOPE.txt"))


def int_arg(args, default):
    return int(args[0]) if args and args[0].isdigit() else default


# ---------- sections ----------

def sec_loop():
    header("LOOP")
    stop = os.path.join(STATE, "STOP")
    if os.path.exists(stop):
        print(f"  STOP flag   {red('SET')} {dim('(' + ago(os.path.getmtime(stop)) + ')')}   -> gnoc resume")
    else:
        print(f"  STOP flag   {green('clear')}")
    glock = read(os.path.join(STATE, "LOCK")).strip().splitlines()
    glock = next((l.split()[0] for l in glock if l.strip() and not l.startswith("#")), "")
    bad = red(" (no targets/" + glock + "/SCOPE.txt: not a program; gnoc unlock or gnoc lock <handle>)") \
        if glock and not has_scope(glock) else ""
    print(f"  global LOCK {yellow(glock) if glock else dim('none (rotate mode)')}{bad}")
    env_t = os.environ.get("HUNT_TARGET")
    if env_t:
        print(f"  HUNT_TARGET {yellow(env_t)} (this shell)")
    # harmony 2.6: active session locks come from the one reader (lib_state); stale (>24 h) ones are counted, not listed
    from bbtools import lib_state
    fresh = lib_state.active_programs(WS)["session_locks"]
    for sid, h, mt in fresh[:6]:
        print(f"  session     {yellow(h):<20} {dim(sid[:8])}  {dim(ago(mt))}")
    n_all = sum(1 for f in (os.listdir(STATE) if os.path.isdir(STATE) else [])
                if f.startswith("LOCK.") and read(os.path.join(STATE, f)).strip())
    if n_all > len(fresh):
        print("  " + dim(f"            {n_all - len(fresh)} stale session lock(s) older than 24 h ignored"))


def sec_services():
    header("SERVICES")
    rc, out, _ = sh("pm2 jlist")
    try:
        procs = json.loads(out) if rc == 0 else []
    except ValueError:
        procs = []
    if procs:
        parts = []
        for p in procs:
            st = p.get("pm2_env", {}).get("status", "?")
            col = green if st == "online" else red
            parts.append(f"{p.get('name')}:{col(st)}")
        print("  pm2         " + "  ".join(parts))
    else:
        print("  pm2         " + dim("unavailable"))
    rc, out, _ = sh("curl -s -m 3 " + os.environ.get("GNOC_LOCAL_OLLAMA", "127.0.0.1:11434") + "/api/ps")
    if rc == 0 and out.strip():
        try:
            models = [m.get("name") for m in json.loads(out).get("models", [])]
            print(f"  ollama-oc   {green('up')}  loaded: {', '.join(models) or dim('none')}")
        except ValueError:
            print(f"  ollama-oc   {green('up')}")
    else:
        print(f"  ollama-oc   {red('down')}  -> gnoc svc restart ollama-oc")
    rc, out, _ = sh("curl -s -m 2 -o /dev/null -w '%{http_code}' 127.0.0.1:9876/")
    burp = out.strip()
    print(f"  burp mcp    {green('listening') if burp not in ('', '000') else dim('not listening')}")


def running_drivers():
    rc, out, _ = sh(["pgrep", "-af", "opencode-lane.sh"])
    rows = []
    for line in out.splitlines():
        if "pgrep" in line:
            continue
        pid, _, cmd = line.partition(" ")
        m = re.search(r"opencode-lane\.sh\s+(\S+)\s+(\S+)", cmd)
        if m and "bash -c" not in cmd:
            rows.append((pid, m.group(1), m.group(2)))
    return rows


def latest_log(prog, lane):
    best = None
    if os.path.isdir(OC_STATE):
        for f in os.listdir(OC_STATE):
            if f.startswith(f"{prog}-{lane}-") and f.endswith(".log"):
                p = os.path.join(OC_STATE, f)
                if best is None or os.path.getmtime(p) > os.path.getmtime(best):
                    best = p
    return best


def sec_lanes(tail=0):
    header("OPENCODE LANES")
    rows = running_drivers()
    if not rows:
        print("  " + dim("no OpenCode driver running (GPU free)"))
    for pid, prog, lane in rows:
        cmds = os.path.join(WS, "targets", prog, "hunts", lane, "commands.txt")
        fired = len(read(cmds).splitlines())
        print(f"  {green('RUN')} pid {pid:<8} {prog}/{lane}  fired={fired}")
        if tail:
            lg = latest_log(prog, lane)
            lines = [re.sub(r"\x1b\[[0-9;]*m", "", l) for l in read(lg).splitlines()] if lg else []
            for l in [l for l in lines if l.strip()][-tail:]:
                print("      " + dim(l[:150]))


def outcomes(n):
    rows = []
    for line in read(os.path.join(STATE, "outcomes.jsonl")).splitlines()[-n:]:
        try:
            rows.append(json.loads(line))
        except ValueError:
            pass
    return rows


VCOL = {"CRITICAL-CANDIDATE": red, "MEDIUM-CANDIDATE": yellow, "LEAD": cyan,
        "DEAD": dim, "UNFIRED": dim, "NEEDS": yellow}


def sec_outcomes(n=8):
    header(f"LAST {n} OUTCOMES")
    for o in outcomes(n):
        v = o.get("verdict", "?")
        col = VCOL.get(v, str)
        ts = (o.get("ts") or "")[5:16].replace("T", " ")
        print(f"  {dim(ts)} {col(v[:9]):<18} {o.get('target','?')[:14]:<14} "
              f"p={o.get('probes','?'):<4} {str(o.get('lane',''))[:44]}")


def count_reports():
    base = os.path.join(WS, "reports")
    counts = {"drafts": 0, "held": 0, "submitted": 0, "leads": 0}
    for kind in ("drafts", "submitted", "leads"):
        root = os.path.join(base, kind)
        for dp, dn, fn in os.walk(root):
            if "report.md" in fn or "SUBMITTED.md" in fn or (kind == "leads" and fn):
                counts[kind] += 1
                if kind == "drafts" and "HELD-REASON.md" in fn:
                    counts["held"] += 1
                dn[:] = []
    return counts


def sec_reports():
    header("REPORTS")
    k = count_reports()
    print(f"  drafts {bold(k['drafts'])} (held {k['held']})   submitted {bold(k['submitted'])}   "
          f"leads {k['leads']}   {dim('-> gnoc reports / reports/STATUS.md')}")


def handoff_section(num):
    text = read(HANDOFF)
    m = re.search(rf"^## {num}\..*?(?=^## \d|\Z)", text, re.S | re.M)
    return m.group(0).rstrip() if m else ""


def sec_counter():
    sec = handoff_section(1)
    m = re.search(r"Validated Critical count: \*\*(.+?)\*\*", sec)
    upd = re.search(r"^Last updated: (.{0,60})", read(HANDOFF), re.M)
    header("COUNTER")
    print(f"  validated critical {bold(m.group(1) if m else '?')}   "
          f"{dim('handoff updated ' + upd.group(1)) if upd else ''}")


def status():
    """Plain-text status (pipes, non-TTY, gnoc chat's snapshot, GNOC_PLAIN=1); `gnoc` on a terminal draws status_screen()."""
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%SZ")
    print(bold(f"The user hunt control  {dim(now)}"))
    sec_counter()
    sec_loop()
    sec_services()
    sec_orch()
    sec_lanes(tail=2)
    sec_outcomes(8)
    sec_reports()
    print(dim("  gnoc help | menu | watch | stop | resume | lock | lane | lanes | outcomes | needs | submit"))


# ---------- actions ----------

def do_stop():
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "STOP"), "w") as f:
        f.write(datetime.now(timezone.utc).isoformat() + " set by gnoc\n")
    _log_change("stop", detail="STOP set")
    print(red("STOP set") + " - loops finish their current step and halt.")


def do_resume():
    p = os.path.join(STATE, "STOP")
    if os.path.exists(p):
        os.remove(p)
        _log_change("resume", detail="STOP cleared")
        print(green("STOP cleared") + " - re-dispatch lanes from their STATUS.md files.")
    else:
        print("STOP was not set.")


def do_lock(args):
    sid = None
    if "--sid" in args:
        i = args.index("--sid")
        sid = args[i + 1] if i + 1 < len(args) else None
        if not sid:  # before: a bare --sid silently pinned the GLOBAL lock
            sys.exit("usage: gnoc lock <handle> --sid <session_id>")
        args = args[:i] + args[i + 2:]
    if not args:
        sys.exit("usage: gnoc lock <handle> [--sid <session_id>]")
    handle = args[0]
    if not os.path.isfile(os.path.join(WS, "targets", handle, "SCOPE.txt")):
        sys.exit(f"no targets/{handle}/SCOPE.txt - run the platform scope fetch first")
    name = f"LOCK.{sid}" if sid else "LOCK"
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, name), "w") as f:
        f.write(handle + "\n")
    _log_change("lock", detail=f"{name} -> {handle}")
    print(f"{name} -> {yellow(handle)}")
    print(dim("  Claude sessions follow the lock; the orch bot follows AUTO-HUNT: gnoc pivot " + handle
              + " switches what the bot hunts"))


def do_unlock(args):
    if "--sid" in args and len(args) <= args.index("--sid") + 1:
        sys.exit("usage: gnoc unlock [--sid <session_id>]")
    sid = args[args.index("--sid") + 1] if "--sid" in args and len(args) > args.index("--sid") + 1 else None
    if sid:
        p = os.path.join(STATE, f"LOCK.{sid}")
        hits = [f[5:] for f in os.listdir(STATE) if f.startswith(f"LOCK.{sid}")] if not os.path.exists(p) else []
        if len(hits) == 1:  # the status screen shows 8-char session prefixes; accept one
            sid, p = hits[0], os.path.join(STATE, f"LOCK.{hits[0]}")
        if not os.path.exists(p):
            sys.exit(f"no single LOCK.{sid}* ({len(hits)} match; session ids: gnoc status, LOOP section)")
        os.remove(p)
        _log_change("unlock", detail=f"LOCK.{sid} cleared")
        print(f"LOCK.{sid} cleared")
    else:
        open(os.path.join(STATE, "LOCK"), "w").close()
        _log_change("unlock", detail="global LOCK cleared")
        print("global LOCK cleared (rotate mode for sessions without their own lock)")


def ws_path(p):
    """A path typed by the user: relative to the shell's cwd when it exists there, else to the workspace."""
    if os.path.isabs(p):
        return p
    return os.path.abspath(p) if os.path.exists(p) else os.path.join(WS, p)


def do_lane(args):
    if len(args) < 4:
        sys.exit("usage: gnoc lane <program> <lane-dir> <brief.md> <probes.txt> [round]")
    prog, lane, brief, probes = args[:4]
    brief, probes = ws_path(brief), ws_path(probes)
    for need in (brief, probes, os.path.join(WS, "targets", prog, "SCOPE.txt")):
        if not os.path.isfile(need):  # the driver runs in the background; a bad path used to fail out of sight
            sys.exit(f"not found: {need}")
    if running_drivers():
        sys.exit("an OpenCode driver is already running (one lane at a time, the GPU holds one model). "
                 "See: gnoc lanes")
    env = dict(os.environ, HUNT_TARGET=prog)
    if len(args) > 4:
        env["ROUND"] = args[4]
    os.makedirs(OC_STATE, exist_ok=True)
    out = os.path.join(OC_STATE, f"{lane}-driver-{datetime.now(timezone.utc):%H%M%S}.out")
    with open(out, "w") as fh:
        p = subprocess.Popen([os.path.join(WS, "scripts/opencode-lane.sh"), prog, lane, brief, probes],
                             cwd=WS, env=env, stdout=fh, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, start_new_session=True)
    # Bind the lane to the chat that started it (GreyNOC, 2026-11-02): closing the chat kills it.
    # Only binds when `gnoc lane` is run from inside a chat; the lane harness itself still refuses
    # to start when no chat is open at all, so a bare shell cannot hunt unattended either way.
    try:
        sys.path.insert(0, os.path.join(WS, "scripts"))
        import gnoc_session
        gnoc_session.register_lane(p.pid, label=f"lane:{prog}/{lane}")
    except Exception:  # noqa: BLE001 - never let bookkeeping kill a lane that already started
        pass
    _log_change("lane", detail=f"started {prog}/{lane} pid {p.pid}")
    print(f"started pid {p.pid}  {prog}/{lane}  driver output: {out}")


def do_kill_lane(args):
    if not args:
        sys.exit("usage: gnoc kill-lane <pid>   (pids: gnoc lanes)")
    pids = {r[0] for r in running_drivers()}
    if args[0] not in pids:
        sys.exit(f"{args[0]} is not a running opencode-lane driver")
    sh(["pkill", "-TERM", "-P", args[0]])
    sh(["kill", "-TERM", args[0]])
    _log_change("lane", detail=f"killed driver {args[0]}")
    print(f"sent TERM to driver {args[0]} and its children")


def do_needs():
    sec = handoff_section(5)
    for line in sec.splitlines():
        if line.startswith("- **"):
            print("  " + yellow("*") + " " + re.sub(r"\*\*", "", line[2:])[:200])


def do_reports():
    rc, _, err = sh("scripts/reports.sh status", timeout=120)
    if rc != 0:
        print(red(f"reports.sh status failed (rc={rc}); showing the previous STATUS.md: {err.strip()[-160:]}"))
    text = read(os.path.join(WS, "reports/STATUS.md"))
    print("\n".join(text.splitlines()[:60]))


def do_svc(args):
    if args[:1] == ["restart"] and len(args) > 1:
        rc, out, err = sh(["pm2", "restart", args[1]])
        print(out or err)
    else:
        rc, out, err = sh(["pm2", "ls"])
        print(out or err)


def do_oss(args):
    """gnoc oss [status|plan|leads|pause|resume [--ack-incident]|drain|undrain|run ...|mark ...|triage [--apply]|
    review [--max N]] - one front door to the oss-bot subsystem (the no-Claude background scanner, pm2 oss-bot) so
    the chair and the CLI can never drift onto two different ways to touch it. triage/review are the two scripts
    that actually live beside bot.py (scripts/oss-bot/{triage,review}.py), not bot.py subcommands - dispatched here
    by name for the same reason. Default (no args, or anything else): bot.py status."""
    sub = args[0] if args else "status"
    if sub == "triage":
        rc = passthrough([sys.executable, os.path.join(WS, "scripts/oss-bot/triage.py")] + args[1:])
    elif sub == "review":
        rc = passthrough([sys.executable, os.path.join(WS, "scripts/oss-bot/review.py"), "run"] + args[1:])
    else:
        rc = passthrough([sys.executable, os.path.join(WS, "scripts/oss-bot/bot.py")] + (args or ["status"]))
    if sub in ("pause", "resume", "drain", "undrain", "mark", "triage", "review") and rc == 0:
        _log_change("oss", detail=" ".join(args))


def _best_oss_lead_program():
    """The program with the strongest open oss-bot signal right now, read-only. INTERIM ranking:
    the highest summed score across a program's open (state=LEAD, not suppressed) leads - no decay,
    no possibly-live weighting, no cooldown. The full version (bands, freshness decay, anti-fixation
    cooldown) is scripts/oss-bot/signal.py per scripts/learn/SPEC-oss-signal-targeting-20261021.md,
    which ships once scripts/auto-target.py unblocks; this exists so 'gnoc start' has something real
    to point at before that lands, without building a second, competing ranking system."""
    db = os.path.join(WS, ".claude/state/oss-bot/bot.db")
    if not os.path.isfile(db):
        return None
    import sqlite3
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
        rows = con.execute(
            "SELECT program, SUM(score) AS total FROM leads "
            "WHERE state='LEAD' AND (suppressed IS NULL OR suppressed='') "
            "GROUP BY program ORDER BY total DESC LIMIT 10").fetchall()
        con.close()
    except sqlite3.Error:
        return None
    for program, _total in rows:
        if has_scope(program) and not _policy_refusal(program):
            return program
    return None


def do_start(args):
    """gnoc start auto hunt [<target>] - one command that gets the whole hunt stack running, not just
    a state file: starts orch-bot and oss-bot if either pm2 process isn't already online (never
    restarts one that's already up and working), clears a plain global STOP, turns the brain on,
    resumes oss-bot if it's on an ordinary pause (a genuine scope-incident pause is NEVER touched here -
    that needs your own `gnoc oss resume --ack-incident`, on purpose), picks a target (yours, or
    oss-bot's strongest open-lead signal via _best_oss_lead_program() when none is given), then starts
    auto-hunt on it exactly the way `gnoc orch auto <target>` already does."""
    if args[:2] != ["auto", "hunt"]:
        sys.exit("usage: gnoc start auto hunt [<target>]")
    # RETIRED 2026-11-02 (GreyNOC): this command existed to stand up the unattended stack - start the
    # two bots, point AUTO-HUNT at a program and walk away. That is precisely what was removed. The
    # body below is kept for reference but is unreachable; hunting starts from a chat now.
    sys.exit(
        "gnoc start auto hunt is RETIRED (2026-11-02): there is no unattended hunt stack.\n"
        "Hunting runs inside a gnoc chat session and stops when you close it.\n"
        "  start:      gnoc chat    then ask it to hunt (it orchestrates lanes on request)\n"
        "  the gate:   python3 scripts/gnoc_session.py status\n"
        "  one lane:   gnoc lane <program> <lane-dir> <brief.md> <probes.txt>   (needs a chat open)")
    target = args[2] if len(args) > 2 else None

    print(bold("starting the hunt stack"))
    try:
        procs = json.loads(sh(["pm2", "jlist"])[1] or "[]")
    except ValueError:
        procs = []
    online = {p.get("name") for p in procs if p.get("pm2_env", {}).get("status") == "online"}
    for name in ("orch-bot", "oss-bot"):
        if name in online:
            print(f"  {green('ok')}      {name} already online")
        else:
            rc, out, err = sh(["pm2", "restart", name])
            print(f"  {green('started') if rc == 0 else red('FAILED')}  {name}" +
                  (f": {err.strip()[:120]}" if rc else ""))

    stop_f = os.path.join(WS, ".claude/state/hunt-loop/STOP")
    if os.path.exists(stop_f):
        os.remove(stop_f)
        print(f"  {green('cleared')}  global STOP")

    pause_f = os.path.join(WS, ".claude/state/oss-bot/PAUSE")
    if os.path.isfile(pause_f):
        content = read(pause_f).strip()
        if content.startswith("INCIDENT"):
            print(f"  {red('left alone')}  oss-bot has a scope-incident pause, not a plain one - not clearing it here:")
            print(dim(f"    {content[:200]}"))
            print(dim("    look at it, then: gnoc oss resume --ack-incident"))
        else:
            passthrough([sys.executable, os.path.join(WS, "scripts/oss-bot/bot.py"), "resume"])
            print(f"  {green('resumed')}  oss-bot (was a plain pause)")

    bf = os.path.join(WS, ".claude/state/orch/BRAIN.enabled")
    if not os.path.isfile(bf):
        os.makedirs(os.path.dirname(bf), exist_ok=True)
        with open(bf, "w") as fh:
            fh.write(datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") + "\n")
        print(f"  {green('on')}      brain (local-model decision layer)")

    if not target:
        target = _best_oss_lead_program()
        if not target:
            print(f"  {yellow('no target given, and no open oss-bot lead to pick one from')}")
            print(dim("    name one yourself: gnoc start auto hunt <target>"))
            _log_change("start", detail="no target available")
            return
        print(f"  {bold('picked')}   {target}  (oss-bot's strongest current open-lead signal - interim ranking,"
              " see signal.py spec)")
    do_orch(["auto", target])
    _log_change("start", detail=f"auto hunt -> {target}")


def do_orch(args):
    """gnoc orch [status|add <program> <lane> <brief> <probes> [round]|queue|inbox|log|pause|resume]"""
    od = os.path.join(WS, ".claude/state/orch")
    sub = args[0] if args else "status"
    if sub == "add":
        if len(args) < 5:
            sys.exit("usage: gnoc orch add <program> <lane-dir> <brief.md> <probes.txt> [round]")
        prog, lane, brief, probes = args[1], args[2], ws_path(args[3]), ws_path(args[4])
        for need in (brief, probes, os.path.join(WS, "targets", prog, "SCOPE.txt")):
            if not os.path.isfile(need):  # the bot would only skip it later with a QUEUE inbox line
                sys.exit(f"not queued, not found: {need}")
        if any("|" in a for a in args[1:6]):
            sys.exit("not queued: '|' is the queue field separator and cannot appear in an argument")
        os.makedirs(od, exist_ok=True)
        with open(os.path.join(od, "queue.txt"), "a") as f:
            f.write("|".join([prog, lane, brief, probes] + args[5:6]) + "\n")
        print(f"queued {prog}/{lane}" + dim("  (the bot starts it when idle; gnoc orch queue)"))
    elif sub == "queue":
        print(read(os.path.join(od, "queue.txt")) or "(queue empty)")
    elif sub == "inbox":
        print("\n".join(read(os.path.join(od, "INBOX.md")).splitlines()[-30:]) or "(inbox empty)")
    elif sub == "log":
        print("\n".join(read(os.path.join(od, "orch.log")).splitlines()[-25:]))
    elif sub == "auto":
        f = os.path.join(od, "AUTO-HUNT")
        arg = args[1] if len(args) > 1 else None
        # RETIRED 2026-11-02 (GreyNOC): AUTO-HUNT was read by orch-bot, which no longer runs. Arming it
        # would print "the bot hunts on its own" and nothing would happen - a lie in the status screen.
        # "off" and "plan" stay: turning it further off is always safe, and plan is read-only.
        if arg not in ("off", "plan"):
            sys.exit(
                "gnoc orch auto is RETIRED (2026-11-02): AUTO-HUNT drove orch-bot, which no\n"
                "longer runs, so arming it would hunt nothing. Hunting runs inside a gnoc chat session.\n"
                "  start:     gnoc chat    then ask it to hunt\n"
                "  the gate:  python3 scripts/gnoc_session.py status\n"
                "  still ok:  gnoc orch auto off | gnoc orch auto plan <program>")
        if arg == "off":
            if os.path.exists(f):
                os.remove(f)
            print("auto-hunt OFF (queued lanes still run)")
            return
        cur_words = read(f).split()
        cur_prog = cur_words[0] if cur_words and cur_words[0] != "target" else None
        if arg == "target":
            os.makedirs(od, exist_ok=True)
            # keep the program being swept (finish it, then move on); before, this dropped it and auto-target
            # restarted from the top of the ranking
            keep = cur_prog if has_scope(cur_prog) else None
            with open(f, "w") as fh:
                fh.write(f"{keep} target\n" if keep else "target\n")
            print(f"auto-hunt ON in {yellow('target')} mode: the bot picks the best program (VDP and paid lists interleaved),")
            print(dim("  intakes it if needed (H1 scope + passive host map), sweeps it, then moves to the next."))
            if keep:
                print(dim(f"  it finishes {keep} first (gnoc pivot to switch now)"))
            print(dim("  see the ranking: gnoc orch rank;  stop: gnoc orch auto off"))
            return
        if arg == "plan":
            prog = (args[2] if len(args) > 2 else None) or cur_prog
            if not prog:
                sys.exit("no program to plan: auto-hunt is off or still picking; usage: gnoc orch auto plan <program>")
            if not has_scope(prog):
                sys.exit(f"no targets/{prog}/SCOPE.txt")
            passthrough([sys.executable, os.path.join(WS, "scripts/auto-hunt.py"), prog, "--plan"])
            return
        if arg in ("paid", "vdp", "on"):
            sys.exit(f"gnoc orch auto {arg} is not a mode. Modes: <program> | target | off | plan  "
                     "(target mode already interleaves VDP and paid programs)")
        prog = arg
        if not prog:  # default: newest FRESH (<24 h) session lock, else the global LOCK (harmony 2.6: a dead
            # session's lock is no longer a default)
            from bbtools import lib_state
            ap = lib_state.active_programs(WS)
            prog = next((h for _, h, _ in ap["session_locks"] if has_scope(h)), None) or \
                (ap["global_lock"] if has_scope(ap["global_lock"]) else None)
        if not prog or not os.path.isfile(os.path.join(WS, "targets", prog, "SCOPE.txt")):
            sys.exit("usage: gnoc orch auto <program>   (needs targets/<program>/SCOPE.txt)")
        pol_why = _policy_refusal(prog)
        if pol_why:
            sys.exit(red(f"auto-hunt refused for {prog}: policy forbids unattended hunting ({pol_why})"))
        os.makedirs(od, exist_ok=True)
        with open(f, "w") as fh:
            fh.write(prog + "\n")
        print(f"auto-hunt ON for {yellow(prog)}: the bot sweeps one host per tick when the lane queue is empty.")
        print(dim("  hits land in gnoc orch inbox as AUTO-HIT;  gnoc orch auto plan;  gnoc orch auto off"))
    elif sub == "brain":
        bf = os.path.join(od, "BRAIN.enabled")
        arg = args[1] if len(args) > 1 else "status"
        if arg == "on":
            with open(bf, "w") as fh:
                fh.write(datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") + "\n")
            print(f"brain {green('ON')}: the local model ({os.environ.get('ORCH_BRAIN_MODEL') or _role_model('brain')}) chooses each next move "
                  "when the bot is idle; code validates every move; fixed rules take over if the model fails.")
            print(dim("  why it chose: gnoc orch brain why   standing notes it reads: .claude/state/orch/BRAIN-NOTES.md"))
            if not read(os.path.join(od, "AUTO-HUNT")).strip():
                print(yellow("  note: auto mode is off; the brain still decides, but turn on gnoc orch auto target so it has a focus"))
        elif arg == "off":
            if os.path.exists(bf):
                os.remove(bf)
            print("brain OFF: the bot runs its fixed rules (queue first, then sweep in plan order)")
        elif arg in ("why", "log"):
            n = int(args[2]) if len(args) > 2 and args[2].isdigit() else 8
            for ln in read(os.path.join(od, "brain.jsonl")).splitlines()[-n:]:
                try:
                    d = json.loads(ln)
                except ValueError:
                    continue
                col = green if d.get("status") in ("ok", "wait") else red
                print(f"{dim(d.get('ts', ''))} {bold(d.get('action') or '')} {col(d.get('status', ''))} {d.get('detail', '')[:120]}"
                      + (f" {dim('(' + str(d['secs']) + 's)')}" if 'secs' in d else ""))
                if d.get("reason"):
                    print("    why: " + d["reason"][:300])
                if d.get("result"):
                    print("    result: " + d["result"][:200])
        elif arg == "test":
            passthrough([sys.executable, os.path.join(WS, "scripts/orch_brain.py")])
        elif arg == "snapshot":
            passthrough([sys.executable, os.path.join(WS, "scripts/orch_brain.py"), "--snapshot"])
        else:
            on = os.path.isfile(bf)
            print(f"brain {green('ON') if on else dim('OFF')}   model {os.environ.get('ORCH_BRAIN_MODEL') or _role_model('brain')}   "
                  f"decisions {len(read(os.path.join(od, 'brain.jsonl')).splitlines())}")
            print(dim("  gnoc orch brain on|off|why [n]|test (dry run, executes nothing)|snapshot"))
    elif sub == "report":
        progs = sorted(f[5:-5] for f in os.listdir(od) if f.startswith("auto-") and f.endswith(".json")
                       and f[5:-5] and os.path.isfile(os.path.join(WS, "targets", f[5:-5], "SCOPE.txt")))
        header("AUTO-HUNT REPORT")
        sys.stdout.flush()
        for prog in progs:
            passthrough([sys.executable, os.path.join(WS, "scripts/auto-hunt.py"), prog, "--report"])
        hits = [l for l in read(os.path.join(od, "INBOX.md")).splitlines() if "AUTO-HIT" in l or "AUTO-LEAD" in l]
        print(f"  inbox: {len(hits)} AUTO-HIT/AUTO-LEAD line(s)" + (" -> gnoc orch inbox" if hits else ""))
    elif sub == "rank":
        passthrough([sys.executable, os.path.join(WS, "scripts/auto-target.py"), "--rank"])
    elif sub == "intake":
        if len(args) < 2:
            sys.exit("usage: gnoc orch intake <h1-handle>")
        if args[1] in RESERVED or not re.fullmatch(r"[a-z0-9][a-z0-9_.-]{1,60}", args[1]):
            sys.exit(f"{args[1]!r} is not a program handle")
        out = os.path.join(od, f"intake-{args[1]}.log")
        with open(out, "w") as fh:
            subprocess.Popen([sys.executable, os.path.join(WS, "scripts/auto-target.py"), "--intake", args[1]],
                             cwd=WS, stdout=fh, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
        print(f"intake of {yellow(args[1])} started in the background (H1 scope + policy ban check + passive host map)")
        print(dim(f"  progress: tail -f {out}"))
    elif sub in ("pause", "resume"):
        do_stop() if sub == "pause" else do_resume()
    elif sub == "status":
        sec_orch(full=True)
    elif sub == "speed":
        intensity_f = os.path.join(od, "office-intensity")
        ticks = {1: 120, 2: 90, 3: 60, 4: 35, 5: 20}  # mirrors orch-bot.py TICK_BY_INTENSITY
        if len(args) < 2:
            try:
                cur = max(1, min(5, int(read(intensity_f).strip() or 3)))
            except ValueError:
                cur = 3
            print(f"tick speed {cur} ({ticks[cur]}s/tick)   gnoc orch speed <1-5>")
            return
        if not args[1].isdigit() or int(args[1]) not in ticks:
            sys.exit("usage: gnoc orch speed <1-5>  (1=120s slowest .. 5=20s fastest per orch-bot tick)")
        lv = int(args[1])
        os.makedirs(od, exist_ok=True)
        with open(intensity_f, "w") as fh:
            fh.write(f"{lv}\n")
        _log_change("speed", detail=f"tick speed -> {lv} ({ticks[lv]}s/tick)")
        print(f"tick speed -> {lv} ({ticks[lv]}s/tick; orch-bot reads this every tick)")
    else:
        sys.exit(f"unknown: gnoc orch {sub}\nusage: gnoc orch [status|queue|inbox|log|pause|resume|report|rank|speed|"
                 "auto [program|target|off|plan]|brain [on|off|why|test|snapshot]|intake <handle>|add ...]")


RESERVED = {"auto", "paid", "vdp", "target", "targets", "off", "on", "next", "status", "plan", "report", "rank",
            "brain", "all", "none", "stop", "resume", "help"}


def _policy_refusal(prog):
    """harmony 2.3: None when prog may be hunted unattended, else the refusal reason. None also when there is no
    SCOPE.txt yet (intake runs the ban check before any request). Same rule as every daemon: lib_policy network_ok."""
    if not prog or not os.path.isfile(os.path.join(WS, "targets", prog, "SCOPE.txt")):
        return None
    try:
        from bbtools import lib_policy  # scripts/ is on sys.path (module level)
        pol = lib_policy.policy(prog)
    except Exception as e:  # fail closed: an unreadable policy is not a green light
        return f"policy unreadable for {prog} ({e})"
    if pol.get("network_ok"):
        return None
    return f"{pol.get('status')}: {pol.get('evidence') or 'network_ok False'}"[:200]


def _valid_handle(prog):
    """(ok, why). A pivot target must be a real program: SCOPE.txt on disk, a priority-list entry, or a handle the
    HackerOne API answers for. Before this check `gnoc pivot auto` created targets/auto and silently killed auto mode."""
    if prog in RESERVED:
        return False, (f"{prog!r} is a command word, not a program handle. To let the bot choose: gnoc pivot  "
                       "(no name) or gnoc orch auto target")
    if not re.fullmatch(r"[a-z0-9][a-z0-9_.-]{1,60}", prog):
        return False, f"{prog!r} is not a valid handle"
    if os.path.isfile(os.path.join(WS, "targets", prog, "SCOPE.txt")):
        return True, "has SCOPE.txt"
    for lst in ("priority-vdp.txt", "priority.txt"):
        if re.search(rf"^\s*{re.escape(prog)}(\s|#|$)", read(os.path.join(STATE, lst)), re.M):
            return True, f"listed in {lst}"
    env = {}
    for ln in read(os.path.expanduser("~/.config/gnoc/secrets.env")).splitlines():
        m = re.match(r"\s*(?:export\s+)?([A-Z_]+)=['\"]?([^'\"]*)", ln)
        if m:
            env[m.group(1)] = m.group(2)
    if not env.get("HACKERONE_API_TOKEN"):
        return False, f"{prog!r} is not on disk or in a priority list, and no H1 token to check it"
    import base64
    import urllib.error
    import urllib.request
    req = urllib.request.Request(f"https://api.hackerone.com/v1/hackers/programs/{prog}", headers={
        "Accept": "application/json", "Authorization": "Basic " + base64.b64encode(
            f"{env.get('HACKERONE_HANDLE', '')}:{env['HACKERONE_API_TOKEN']}".encode()).decode()})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return (r.status == 200), "HackerOne knows this handle"
    except urllib.error.HTTPError as e:
        return False, f"HackerOne answered {e.code} for {prog!r} (wrong handle, or private and we are not invited)"
    except Exception as e:
        return False, f"could not verify {prog!r} with HackerOne ({e})"


def do_unpark(args):
    """gnoc unpark all | gnoc unpark <program> [<program> ...] | gnoc unpark (list parked)
    Clears the parked flag so the bot may pick the program again. Exhausted programs stay exhausted unless --reset."""
    od = os.path.join(WS, ".claude/state/orch")
    parked = {}
    for f in sorted(os.listdir(od)) if os.path.isdir(od) else []:
        if f.startswith("auto-") and f.endswith(".json"):
            try:
                st = json.loads(read(os.path.join(od, f)) or "{}")
            except ValueError:
                continue
            if st.get("parked") or ("--reset" in args and st.get("exhausted")):
                parked[f[5:-5]] = st
    names = [a for a in args if not a.startswith("-")]
    if not names:
        if not parked:
            print("nothing is parked")
        for p, st in parked.items():
            print(f"  {p:<28} parked" + ("  exhausted" if st.get("exhausted") else "") + f"  swept {len(st.get('swept', {}))}")
        print(dim("  gnoc unpark all  |  gnoc unpark <program> ...  (--reset also clears exhausted)"))
        return
    targets = list(parked) if names == ["all"] else names
    unknown = [n for n in targets if n not in parked]
    if unknown:
        sys.exit(red(f"not parked: {', '.join(unknown)}") + "  (gnoc unpark lists the parked programs)")
    for p in targets:
        st = parked[p]
        st["parked"] = False
        if "--reset" in args:
            st["exhausted"] = False
        with open(os.path.join(od, f"auto-{p}.json"), "w") as fh:
            json.dump(st, fh, indent=1)
    with open(os.path.join(od, "INBOX.md"), "a") as fh:
        fh.write(f"- [{datetime.now(timezone.utc):%Y-%m-%dT%H:%M:%SZ}] **PIVOT** unparked {', '.join(targets)}\n")
    print(f"unparked {green(', '.join(targets))}; the ranker can pick them again (gnoc orch rank)")


def do_pivot(args):
    """gnoc pivot [program]: no name = park the current auto program and let auto-target pick the next best;
    a name = switch the hunt to it now (intake first if it is new). Parking is undone by pivoting back.
    --no-lock (the brain passes it): leave the global LOCK alone; it is a human session's scope context."""
    no_lock = "--no-lock" in args
    args = [a for a in args if a != "--no-lock"]
    od = os.path.join(WS, ".claude/state/orch")
    os.makedirs(od, exist_ok=True)
    af = os.path.join(od, "AUTO-HUNT")
    words = read(af).split()
    current = words[0] if words and words[0] != "target" else None

    def set_flag(prog, **kv):
        sp = os.path.join(od, f"auto-{prog}.json")
        try:
            st = json.loads(read(sp) or "{}")
        except ValueError:
            st = {}
        st.setdefault("swept", {})
        st.update(kv)
        with open(sp, "w") as fh:
            json.dump(st, fh, indent=1)

    def note(msg):
        ib = os.path.join(od, "INBOX.md")
        try:
            tail = open(ib).read()[-3000:].splitlines()[-6:]
        except OSError:
            tail = []
        if any(f"**PIVOT** {msg}" in l for l in tail):   # 435 PIVOT lines by 2026-10-25: a repeat within six lines is noise
            _log_change("pivot", detail=msg)
            return
        with open(ib, "a") as fh:
            fh.write(f"- [{datetime.now(timezone.utc):%Y-%m-%dT%H:%M:%SZ}] **PIVOT** {msg}\n")
        _log_change("pivot", detail=msg)

    def stop_pick():
        # a running auto-target pick rewrites AUTO-HUNT when it finishes and would silently undo this pivot
        try:
            cur = json.loads(read(os.path.join(od, "state.json")) or "{}").get("current") or {}
        except ValueError:
            cur = {}
        if cur.get("kind") == "target" and pid_alive(cur.get("pid")):
            try:
                os.killpg(int(cur["pid"]), 15)  # started with start_new_session, so pgid == pid
                print(dim(f"  stopped the running auto-target pick (pid {cur['pid']}) so it cannot overwrite this pivot"))
            except (OSError, ValueError):
                pass

    if not args or args[0] == "next":
        if current:
            set_flag(current, parked=True)
        stop_pick()
        with open(af, "w") as fh:
            fh.write("target\n")
        if not no_lock and current and read(os.path.join(STATE, "LOCK")).strip() == current:
            open(os.path.join(STATE, "LOCK"), "w").close()  # do not leave the global LOCK on the parked program
        note(f"parked {current or '(none)'}; auto-target picks the next program" + ("; global LOCK untouched" if no_lock else ""))
        print(f"pivot: parked {yellow(current) if current else dim('(no current program)')}; "
              "the bot picks the next best program on its next tick (gnoc orch rank shows the order)"
              + ("; global LOCK untouched" if no_lock else ""))
        return
    prog = args[0].strip().lower() if args[0] not in ("next",) else args[0]
    ok, why = _valid_handle(prog)
    if not ok:
        sys.exit(red(f"pivot refused: {why}") + "\n  gnoc orch rank lists the programs the bot knows; "
                 "gnoc pivot (no name) lets the bot pick")
    pol_why = _policy_refusal(prog)
    if pol_why:
        sys.exit(red(f"pivot refused: {prog} policy forbids unattended hunting ({pol_why})")
                 + "\n  override is the user's call only: .claude/state/oss-bot/policy-overrides.txt '<program> allow <quote + date>'")
    if prog == current:
        try:
            st = json.loads(read(os.path.join(od, f"auto-{prog}.json")) or "{}")
        except ValueError:
            st = {}
        if st.get("parked") or st.get("exhausted"):  # "pivot back to unpark" must work on the current one too
            set_flag(prog, parked=False, exhausted=False)
            note(f"{prog} unparked")
            print(f"already hunting {prog}; cleared its parked/exhausted flags")
        else:
            print(f"already hunting {prog}")
        return
    if current:
        set_flag(current, parked=True)
    set_flag(prog, parked=False, exhausted=False)
    stop_pick()
    mode = " target" if "target" in words else ""
    if not os.path.isfile(os.path.join(WS, "targets", prog, "SCOPE.txt")):
        out = os.path.join(od, f"intake-{prog}.log")
        with open(out, "w") as fh:
            subprocess.Popen([sys.executable, os.path.join(WS, "scripts/auto-target.py"), "--intake", prog],
                             cwd=WS, stdout=fh, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
        print(f"{prog} is new: intake running in the background ({out}); the bot starts sweeping once the host map exists")
    with open(af, "w") as fh:
        fh.write(f"{prog}{mode}\n")
    if not no_lock:
        with open(os.path.join(STATE, "LOCK"), "w") as fh:
            fh.write(prog + "\n")
    note(f"{current or '(none)'} -> {prog}" + (" (target mode stays on)" if mode else "")
         + ("; global LOCK untouched" if no_lock else ""))
    print(f"pivot: {yellow(current or '(none)')} -> {green(prog)}   ("
          + (f"auto-hunt now points at {prog}; global LOCK untouched" if no_lock
             else f"global LOCK and auto-hunt now point at {prog}")
          + ("; target mode stays on, so the bot moves on when it is finished" if mode else "") + ")")


def sec_orch(full=False):
    header("ORCH BOT")
    od = os.path.join(WS, ".claude/state/orch")
    try:
        st = json.loads(read(os.path.join(od, "state.json")) or "{}")
    except ValueError:
        st = {}
    hb = st.get("heartbeat", "")
    q = [l for l in read(os.path.join(od, "queue.txt")).splitlines() if l.strip() and not l.startswith("#")]
    inbox_n = sum(1 for l in read(os.path.join(od, "INBOX.md")).splitlines() if l.startswith("- ["))
    cur = st.get("current")
    auto = " ".join(read(os.path.join(od, "AUTO-HUNT")).split()) or None
    if cur:
        name = f"{cur.get('program')}/{cur.get('lane')}"
        lane = green(f"{name} (pid {cur.get('pid')})") if pid_alive(cur.get("pid")) else \
            dim(f"{name} finished (pid {cur.get('pid')} gone; the bot collects it next tick)")
    else:
        lane = dim("idle")
    try:
        stale = time.time() - datetime.strptime(hb, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp() > 300
    except ValueError:
        stale = bool(hb)
    hbs = red(hb + " (stale: bot busy in a long model call, or down; gnoc orch brain why / gnoc svc)") \
        if stale else hb or red("none")
    brain_on = os.path.isfile(os.path.join(od, "BRAIN.enabled"))
    print(f"  heartbeat {hbs}   auto {green(auto) if auto else dim('off')}   brain {green('on') if brain_on else dim('off')}   "
          f"queue {bold(len(q))}   inbox {yellow(inbox_n)}")
    print(f"  lane      {lane}")
    if os.path.exists(os.path.join(STATE, "STOP")):
        print("  " + red("STOP is set: the bot starts nothing new (gnoc resume)"))
    if full:
        for l in q[:8]:
            print("  queued  " + dim(l[:140]))
        for l in read(os.path.join(od, "INBOX.md")).splitlines()[-8:]:
            if l.startswith("- ["):
                print("  " + l[:200])


INBOX_DIR = os.path.join(WS, ".claude/state/orch")


def _inbox_items():
    """[(n, line, key)] for every message line in INBOX.md, numbered from 1 in file order."""
    lines = [l for l in read(os.path.join(INBOX_DIR, "INBOX.md")).splitlines() if l.startswith("- [")]
    import hashlib
    return [(i + 1, l, hashlib.sha1(l.encode()).hexdigest()[:12]) for i, l in enumerate(lines)]


def _inbox_read_keys():
    try:
        return set(json.loads(read(os.path.join(INBOX_DIR, "inbox-read.json")) or "[]"))
    except ValueError:
        return set()


def _pick(items, sel):
    """sel: all | read | a number | a range 3-7 | a comma list 1,4,9 -> the matching items."""
    if sel == "all":
        return items
    if sel == "read":
        keys = _inbox_read_keys()
        return [it for it in items if it[2] in keys]
    want = set()
    for part in sel.split(","):
        if "-" in part:
            a, b = part.split("-", 1)
            want |= set(range(int(a), int(b) + 1))
        elif part.isdigit():
            want.add(int(part))
    return [it for it in items if it[0] in want]


