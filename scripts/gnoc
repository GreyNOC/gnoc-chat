CHAT_HIST = os.path.join(WS, ".claude/state/orch/chat-history.json")
CHAT_SYSTEM = (
    "You are the the user hunt dashboard assistant, answering questions about an automated bug-bounty hunting bot. "
    "Answer ONLY from the STATE block, which is a fresh snapshot of the bot's status, report, inbox, log, leads and "
    "mined routes. If the answer is not in STATE, say you cannot see it and name the gnoc command that would show it. "
    "Never invent a finding, a host, a number or a result. Be short and concrete. When an action helps, suggest the exact "
    "gnoc command (gnoc pivot <program>, gnoc orch auto target, gnoc inbox, gnoc orch report, gnoc orch rank, gnoc zip, "
    "gnoc stop, gnoc resume); you never run commands yourself. Plain English, no markdown tables. /no_think")


def _chat_state():
    """A compact live snapshot for the model: status, auto report, inbox, bot log, newest leads and routes."""
    import contextlib
    import io
    strip = lambda t: re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", t)
    parts = []
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        try:
            status()
        except Exception as e:
            print(f"(status failed: {e})")
    parts.append("== STATUS ==\n" + strip(buf.getvalue()))
    od = os.path.join(WS, ".claude/state/orch")
    rep = []
    for f in sorted(os.listdir(od)) if os.path.isdir(od) else []:
        if f.startswith("auto-") and f.endswith(".json") and os.path.isfile(os.path.join(WS, "targets", f[5:-5], "SCOPE.txt")):
            r = subprocess.run([sys.executable, os.path.join(WS, "scripts/auto-hunt.py"), f[5:-5], "--report"],
                               capture_output=True, text=True, cwd=WS, timeout=60)
            rep.append(r.stdout.strip())
    parts.append("== AUTO-HUNT REPORT ==\n" + "\n".join(rep))
    parts.append("== AUTO-HUNT MODE ==\n" + (read(os.path.join(od, "AUTO-HUNT")).strip() or "off"))
    parts.append("== INBOX (last 15) ==\n" + "\n".join(read(os.path.join(od, "INBOX.md")).splitlines()[-15:]))
    parts.append("== BOT LOG (last 15) ==\n" + "\n".join(read(os.path.join(od, "orch.log")).splitlines()[-15:]))
    leads = []
    for prog in sorted(os.listdir(os.path.join(WS, "targets"))):
        lf = os.path.join(WS, "targets", prog, "hunts/auto-exposure/LEADS.md")
        if os.path.isfile(lf):
            leads += [f"{prog}: {l[2:]}" for l in read(lf).splitlines()[-6:]]
            rdir = os.path.join(WS, "targets", prog, "hunts/auto-exposure/routes")
            if os.path.isdir(rdir):
                leads.append(f"{prog}: {len(os.listdir(rdir))} host route file(s) in targets/{prog}/hunts/auto-exposure/routes/")
    parts.append("== LEADS (newest per program) ==\n" + "\n".join(leads[-30:]))
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    today_rows = [r for r in _jsonl_tail(SHIPS_LOG, 2000) if str(r.get("ts", "")).startswith(today)]
    lines = [f"{str(r.get('ts', ''))[11:16]} {r.get('kind', '?')} {r.get('program') or r.get('target', '?')} "
             f"{'FILED' if r.get('filed') else (r.get('status') or '').upper()} {r.get('slug') or r.get('title', '')}"
             for r in today_rows]
    # last and most protected from the tail-truncation below: an exact precomputed count beats the
    # model doing its own date arithmetic over timestamps scattered through the sections above
    parts.append(f"== REPORTS/DRAFTS WRITTEN TODAY (UTC {today}): {len(today_rows)} ==\n"
                 + ("\n".join(lines) if lines else "(none so far today)"))
    text = "\n\n".join(parts)
    return text[-9000:]


def chat_once(question, history):
    import urllib.request
    msgs = [{"role": "system", "content": CHAT_SYSTEM}]
    msgs += history[-6:]
    msgs.append({"role": "user", "content": f"STATE:\n{_chat_state()}\n\nQUESTION: {question}"})
    body = json.dumps({"model": CHAT_MODEL, "messages": msgs, "stream": False,
                       "options": {"num_ctx": 16384, "temperature": 0.2,
                                   # a capped answer: an uncapped 14B on one GPU slot can loop for many minutes
                                   # and every other model user (the bot's brain, OpenCode lanes) queues behind it
                                   "num_predict": int(os.environ.get("GNOC_CHAT_MAX_TOKENS", "700"))}}).encode()
    req = urllib.request.Request(CHAT_URL, data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=600) as r:
        ans = json.loads(r.read().decode()).get("message", {}).get("content", "")
    ans = re.sub(r"<think>.*?</think>", "", ans, flags=re.S).strip()
    history += [{"role": "user", "content": question}, {"role": "assistant", "content": ans}]
    return ans, history[-12:]


# ----- gnoc chat: slash-command plumbing (model switch, GPU routing, bot ingestion) -----
CHAT_SESSION = os.path.join(WS, ".claude/state/orch/chat-session.json")  # {"spec": "name"|"name@desktop"}
INGESTED_BOTS = os.path.join(WS, ".claude/state/orch/ingested-bots.json")
BOTS_DIR = os.path.join(WS, "scripts/bots-ingested")


def _chat_session():
    try:
        return json.loads(read(CHAT_SESSION) or "{}")
    except ValueError:
        return {}


def _save_chat_session(s):
    os.makedirs(os.path.dirname(CHAT_SESSION), exist_ok=True)
    with open(CHAT_SESSION, "w") as f:
        json.dump(s, f)


def _spec_split(spec):
    """'name@desktop' -> ('name', 'desktop'); 'name' -> ('name', 'local'). Never raises, even if
    llm_endpoints failed to import (the import at module top is best-effort)."""
    try:
        return llm_endpoints.split(spec)
    except NameError:
        pass
    except Exception:
        pass
    spec = (spec or "").strip()
    if "@" in spec and spec.rsplit("@", 1)[1] in ("local", "desktop"):
        name, host = spec.rsplit("@", 1)
        return name, host
    return spec, "local"


def _chat_url_for(host):
    return f"{OLLAMA}/api/chat" if host == "local" else f"http://{DESKTOP_OLLAMA}/api/chat"


def _list_models_both():
    """{'local': [names] or None (unreachable), 'desktop': [names] or None}."""
    out = {}
    for host, url in (("local", f"{OLLAMA}/api/tags"), ("desktop", f"http://{DESKTOP_OLLAMA}/api/tags")):
        try:
            out[host] = [m["name"] for m in (_http_json(url, 3).get("models") or [])]
        except Exception:
            out[host] = None
    return out


def chat_once_routed(question, history, url, model):
    """Same shape as chat_once/desktop_chat_once but parameterized by URL+model, for the unified
    /model + /route session in gnoc chat (always STATE-aware; dchat's --raw stays separate)."""
    import urllib.request
    msgs = [{"role": "system", "content": CHAT_SYSTEM}] + history[-6:]
    msgs.append({"role": "user", "content": f"STATE:\n{_chat_state()}\n\nQUESTION: {question}"})
    # think=False: this is a quick read-only Q&A, and a qwen3.5 build with thinking ON puts its whole
    # answer in the `thinking` field, leaving content empty - simple mode printed a bare "bot>" every
    # time (measured 2026-10-25). If a server ignores the flag, fall back to the reasoning text rather
    # than showing nothing.
    body = json.dumps({"model": model, "messages": msgs, "stream": False, "think": False,
                       "options": {"num_ctx": 16384, "temperature": 0.2,
                                   "num_predict": int(os.environ.get("GNOC_CHAT_MAX_TOKENS", "700"))}}).encode()
    req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=600) as r:
            msg = json.loads(r.read().decode()).get("message", {}) or {}
    except urllib.error.HTTPError as e:
        with e:  # a server that rejects `think` answers 400: retry once without it
            detail = e.read().decode(errors="replace")[:200]
        if e.code != 400 or "think" not in detail.lower():
            raise
        body = json.dumps({"model": model, "messages": msgs, "stream": False,
                           "options": {"num_ctx": 16384, "temperature": 0.2,
                                       "num_predict": int(os.environ.get("GNOC_CHAT_MAX_TOKENS", "700"))}}).encode()
        req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=600) as r:
            msg = json.loads(r.read().decode()).get("message", {}) or {}
    ans = msg.get("content", "") or ""
    ans = re.sub(r"<think>.*?</think>", "", ans, flags=re.S).strip()
    if not ans and (msg.get("thinking") or "").strip():
        ans = (msg["thinking"] or "").strip()
    history += [{"role": "user", "content": question}, {"role": "assistant", "content": ans}]
    return ans, history[-12:]


def _chat_help():
    print(dim("  /model                   list models on both the laptop and the desktop GPU"))
    print(dim("  /model <name>            switch model, same GPU"))
    print(dim("  /model <name>@desktop    switch model AND route to the desktop GPU"))
    print(dim("  /route [laptop|desktop]  show, or switch, which GPU answers (keeps the model name if it exists there)"))
    print(dim("  /clone <repo-url>        clone a bot/agent repo into scripts/bots-ingested/ for review - inspects"))
    print(dim("                           only (language, entry point, README), never installs or runs anything"))
    print(dim("  /bots                    list ingested bots"))
    print(dim("  /stophunt                kill all hunting (bots, workers, fuzzers, emulator, other models)"))
    print(dim("                           so the chat gets the whole machine; undo: gnoc start auto hunt"))
    print(dim("  /reset                   clear this chat's history"))
    print(dim("  /help                    this list"))
    print(dim("  q / quit / exit          leave"))


def do_model_cmd(rest):
    sess = _chat_session()
    cur_name, cur_host = _spec_split(sess.get("spec") or _role_model("chat"))
    if not rest:
        models = _list_models_both()
        print(dim(f"current: {cur_name}" + ("" if cur_host == "local" else f" @ {cur_host}")))
        for host, label, addr in (("local", "laptop", OLLAMA.rsplit("//", 1)[-1]), ("desktop", "desktop", DESKTOP_OLLAMA)):
            names = models.get(host)
            print(bold(f"  {label} ({addr}):"))
            if names is None:
                print(dim("    not reachable"))
                continue
            if not names:
                print(dim("    (no models installed - gnoc models pull <owner/repo>)"))
            for n in sorted(names):
                print(f"    {n}" + ("  <-- current" if host == cur_host and n in (cur_name, cur_name + ":latest") else ""))
        print(dim("  /model <name> | /model <name>@desktop | /route laptop|desktop"))
        return
    spec = rest[0]
    name, host = _spec_split(spec)
    avail = _list_models_both().get(host)
    if avail is not None and name not in avail and name + ":latest" not in avail:
        print(red(f"{name!r} is not installed on the {'desktop' if host == 'desktop' else 'laptop'} Ollama"))
        print(dim("  gnoc models search <words>   then   gnoc models pull <owner/repo>"
                  + ("  --on desktop" if host == "desktop" else "")))
        return
    _save_chat_session(dict(sess, spec=spec))
    print(green(f"model -> {name}" + ("" if host == "local" else f" @ {host}")))


def do_route_cmd(rest):
    sess = _chat_session()
    cur_name, cur_host = _spec_split(sess.get("spec") or _role_model("chat"))
    if not rest:
        print(dim(f"routed to: {'laptop' if cur_host == 'local' else 'desktop'}  (model: {cur_name})"))
        print(dim("  /route laptop | /route desktop"))
        return
    want = rest[0].lower()
    want_host = "local" if want in ("laptop", "local") else "desktop" if want == "desktop" else None
    if want_host is None:
        print(red("usage: /route laptop|desktop"))
        return
    if want_host == cur_host:
        print(dim(f"already routed to {want}"))
        return
    avail = _list_models_both().get(want_host)
    if not avail:
        print(red(f"the {want} Ollama is not reachable (gnoc svc, or gnoc models desktop)"))
        return
    name = cur_name if (cur_name in avail or cur_name + ":latest" in avail) else \
        ((_desktop_default_model() if want_host == "desktop" else None) or _role_model("chat"))
    spec = name if want_host == "local" else f"{name}@desktop"
    _save_chat_session(dict(sess, spec=spec))
    print(green(f"routed to {want}: {name}"))


def _safe_bot_name(url):
    base = re.sub(r"\.git$", "", url.rstrip("/").rsplit("/", 1)[-1])
    base = re.sub(r"[^A-Za-z0-9._-]", "-", base).strip("-")
    return base.lower() or "bot"


def _inspect_cloned_repo(path):
    """Read-only: language/stack signals, a likely entry point, a README snippet. Never executed."""
    info = {"lang": [], "entry_point_guess": None, "readme_snippet": ""}
    names = set(os.listdir(path)) if os.path.isdir(path) else set()
    for marker, lang in (("requirements.txt", "python"), ("pyproject.toml", "python"), ("setup.py", "python"),
                         ("package.json", "node"), ("go.mod", "go"), ("Cargo.toml", "rust"), ("Dockerfile", "docker")):
        if marker in names and lang not in info["lang"]:
            info["lang"].append(lang)
    for cand in ("main.py", "cli.py", "app.py", "bot.py", "run.py", "__main__.py"):
        if cand in names:
            info["entry_point_guess"] = cand
            break
    if not info["entry_point_guess"] and "package.json" in names:
        try:
            pkg = json.loads(read(os.path.join(path, "package.json")) or "{}")
            info["entry_point_guess"] = pkg.get("main") or (pkg.get("bin") if isinstance(pkg.get("bin"), str) else None)
        except ValueError:
            pass
    for cand in ("README.md", "readme.md", "README.rst", "README"):
        if cand in names:
            info["readme_snippet"] = " ".join(read(os.path.join(path, cand)).split())[:300]
            break
    return info


def do_clone(args):
    """/clone <repo-url>  (or `gnoc chat /clone <repo-url>`)
    Clones a bot/agent repo into scripts/bots-ingested/<name>/ and inspects it (language, likely
    entry point, README snippet) - read-only. Nothing is installed or executed: review the code
    yourself before wiring it into anything that touches a real target or credential."""
    if not args:
        print(red("usage: /clone <repo-url>  (an https://, git@, or bare owner/repo)"))
        return
    url = args[0]
    import gnoc_hf
    if gnoc_hf.is_hf(url):  # a Hugging Face model: clone it into Ollama as a chat bot, not into bots-ingested
        import gnoc_agent
        return gnoc_hf.cmd(["clone"] + list(args), set_role=gnoc_agent.set_role)
    if re.fullmatch(r"[\w.-]+/[\w.-]+", url):
        url = f"https://github.com/{url}"
    elif not re.match(r"^(https?://|git@)", url):
        print(red(f"doesn't look like a repo URL or owner/repo: {url!r}"))
        return
    name = _safe_bot_name(url)
    os.makedirs(BOTS_DIR, exist_ok=True)
    dest = os.path.join(BOTS_DIR, name)
    if os.path.isdir(dest):
        print(yellow(f"already cloned: scripts/bots-ingested/{name}/ (git -C that dir pull, by hand, to update)"))
    else:
        print(dim(f"cloning {url} -> scripts/bots-ingested/{name}/ ..."), flush=True)
        try:
            r = subprocess.run(["git", "clone", "--depth", "1", url, dest], capture_output=True, text=True, timeout=120)
        except subprocess.TimeoutExpired:
            print(red("clone timed out after 120s"))
            return
        if r.returncode != 0:
            print(red(f"clone failed: {r.stderr.strip()[-300:]}"))
            return
    info = _inspect_cloned_repo(dest)
    try:
        manifest = json.loads(read(INGESTED_BOTS) or "[]")
    except ValueError:
        manifest = []
    manifest = [m for m in manifest if m.get("name") != name] + [{
        "name": name, "url": url, "path": os.path.relpath(dest, WS), "lang": info["lang"],
        "entry_point_guess": info["entry_point_guess"],
        "cloned_at": datetime.now(timezone.utc).isoformat(timespec="seconds")}]
    os.makedirs(os.path.dirname(INGESTED_BOTS), exist_ok=True)
    with open(INGESTED_BOTS, "w") as f:
        json.dump(manifest, f, indent=1)
    print(green(f"cloned and inspected: {name}"))
    print(f"  path         scripts/bots-ingested/{name}/")
    print(f"  stack        {', '.join(info['lang']) or 'not recognized'}")
    print(f"  entry point  {info['entry_point_guess'] or '(not auto-detected - check its README)'}")
    if info["readme_snippet"]:
        print(f"  readme       {info['readme_snippet']}")
    print(dim("  NOTHING was installed or executed. This ingests it for review; it does not wire it"))
    print(dim("  into the hunt loop, run its setup, or run its code - that stays a deliberate, separate step."))
    _log_change("clone", detail=f"ingested {name} from {url}")


def do_bots_cmd(args):
    try:
        manifest = json.loads(read(INGESTED_BOTS) or "[]")
    except ValueError:
        manifest = []
    if not manifest:
        print(dim("no bots ingested yet. /clone <repo-url> to pull one in for review."))
        return
    for m in manifest:
        print(f"  {m['name']:<24} {', '.join(m.get('lang') or []) or '?':<16} {m['path']}")
        print(dim(f"    {m['url']}  (cloned {m.get('cloned_at', '?')})"))


HUNT_PM2 = ("orch-bot", "oss-bot", "pipeline-sweep")  # ollama-oc stays up: it serves the chat


def _proc_table():
    """{pid: (ppid, argv)} straight from /proc, so nothing here can match its own pgrep line."""
    procs = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
            with open(f"/proc/{d}/cmdline", "rb") as f:
                argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except (OSError, IndexError, ValueError):
            continue
        if argv:
            procs[int(d)] = (ppid, argv)
    return procs


def _descendants(roots, procs):
    kids = {}
    for pid, (ppid, _) in procs.items():
        kids.setdefault(ppid, []).append(pid)
    out, todo = set(), list(roots)
    while todo:
        for k in kids.get(todo.pop(), []):
            if k not in out:
                out.add(k)
                todo.append(k)
    return out


def _hunt_kind(argv):
    exe = os.path.basename(argv[0])
    if any(a.startswith("-max_total_time=") for a in argv[1:]):
        return "fuzzer"
    if exe == "claude" and "-p" in argv[1:]:
        return "claude worker"
    if "qemu-system" in exe and "-avd" in argv:
        return "android emulator"
    if any(os.path.basename(a) == "opencode-lane.sh" for a in argv[:3]):
        return "opencode lane"
    return None


def do_stophunt(_args=None, keep=None):
    """/stophunt - kill all hunting and hand the machine to the chat: sets STOP, stops the hunt pm2
    processes (orch-bot, oss-bot, pipeline-sweep) and every child they left behind (orch-bot runs
    without treekill), kills headless claude -p workers, opencode lanes, libFuzzer runs and the
    Android emulator, then unloads every laptop Ollama model except the chat model. Burp, browsers
    and interactive claude sessions are left alone. Undo: gnoc start auto hunt.
    keep: model names to leave loaded. gnoc chat passes its lead and worker: the default reads the simple
    chat's chat-session.json, which the agent never routes from, so /stophunt unloaded the agent's own model."""
    import signal
    import urllib.request
    do_stop()
    procs = _proc_table()
    me = set()
    p = os.getpid()
    while p in procs and p not in me:  # never kill our own ancestry
        me.add(p)
        p = procs[p][0]

    try:
        pm2 = json.loads(sh(["pm2", "jlist"])[1] or "[]")
    except ValueError:
        pm2 = []
    pm2_pids = {x.get("pid") for x in pm2 if x.get("name") in HUNT_PM2 and x.get("pid")}
    orphans = _descendants(pm2_pids, procs)
    for name in HUNT_PM2:
        rc, _, err = sh(["pm2", "stop", name])
        print(f"  {green('stopped') if rc == 0 else red('FAILED')}  pm2 {name}" + (f": {err.strip()[:100]}" if rc else ""))

    targets = {}
    for pid, (_, argv) in procs.items():
        kind = "pm2 child" if pid in orphans else _hunt_kind(argv)
        if kind:
            targets[pid] = kind
    for pid in list(targets):  # take whole trees: fuzzer -fork children, worker subprocesses
        for d in _descendants([pid], procs):
            targets.setdefault(d, targets[pid])
    for pid in me:
        targets.pop(pid, None)

    for pid in targets:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    time.sleep(3)
    for pid in targets:
        if os.path.exists(f"/proc/{pid}"):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    counts = {}
    for kind in targets.values():
        counts[kind] = counts.get(kind, 0) + 1
    for kind, n in sorted(counts.items()):
        print(f"  {green('killed')}   {n} x {kind}")
    if not counts:
        print(dim("  no hunt processes were running"))

    keep = [k for k in (keep or [_spec_split(_chat_session().get("spec") or _role_model("chat"))[0]]) if k]
    try:
        loaded = [m["name"] for m in (_http_json(f"{OLLAMA}/api/ps", 3).get("models") or [])]
    except Exception:
        loaded = []
    for name in loaded:
        if name in keep or name.removesuffix(":latest") in keep:
            continue
        try:
            req = urllib.request.Request(f"{OLLAMA}/api/generate", headers={"Content-Type": "application/json"},
                                         data=json.dumps({"model": name, "keep_alive": 0}).encode())
            urllib.request.urlopen(req, timeout=30).read()
            print(f"  {green('unloaded')} {name} from the laptop GPU")
        except Exception as e:
            print(f"  {red('FAILED')}   unloading {name}: {e}")
    _log_change("stophunt", detail=", ".join(f"{n} {k}" for k, n in counts.items()) or "nothing running")
    print(dim(f"  chat keeps {', '.join(keep)}. Resume hunting with: gnoc start auto hunt"))


def do_resumehunt(_args=None):
    """/resumehunt in gnoc chat: clear the global STOP, and name any hunt pm2 process /stophunt left stopped
    (clearing STOP alone does not restart them; it used to be described as the full undo)."""
    do_resume()
    try:
        procs = json.loads(sh(["pm2", "jlist"])[1] or "[]")
    except (ValueError, OSError):
        procs = []
    down = [p.get("name") for p in procs
            if p.get("name") in HUNT_PM2 and p.get("pm2_env", {}).get("status") != "online"]
    if down:
        print(yellow(f"  still stopped: {', '.join(down)}") + dim("  (gnoc start auto hunt restarts them)"))


SPLIT_DEFAULT_MODEL = "qwen3:8b"
SPLIT_RPC = ("127.0.0.1", 50052)


def _ollama_blob(name):
    """GGUF path of a model in the laptop's ollama-oc store (the split server loads the same file)."""
    base = os.environ.get("OLLAMA_MODELS", os.path.expanduser("~/.ollama/models"))
    repo, _, tag = name.partition(":")
    parts = repo.split("/")
    if len(parts) == 1:
        parts = ["registry.ollama.ai", "library"] + parts
    man = os.path.join(base, "manifests", *parts, tag or "latest")
    try:
        layers = json.loads(read(man) or "{}").get("layers", [])
    except ValueError:
        return None
    for layer in layers:
        if layer.get("mediaType", "").endswith(".model"):
            return os.path.join(base, "blobs", layer["digest"].replace(":", "-"))
    return None


PHONE_RPC = ("127.0.0.1", 50053)  # adb forward -> the phone's ggml-rpc-server (scripts/phone-link)


def _rpc_probe(timeout=25, ep=None):
    """(ok, why). A TCP accept is NOT an RPC device: the reverse SSH tunnel listens on the laptop even when the
    desktop's ggml-rpc-server is dead or built against another llama.cpp (the RPC protocol is version-locked),
    and a bare connect() then reports 'reachable' while split-llm crash-loops. Ask llama.cpp itself."""
    import socket
    ep = ep or SPLIT_RPC
    try:
        socket.create_connection(ep, timeout=2).close()
    except OSError as e:
        return False, f"nothing listening on {ep[0]}:{ep[1]} ({e.__class__.__name__}): the reverse "
    build = os.environ.get("SPLIT_BUILD", "b11476")
    binr = os.path.expanduser(f"~/.local/opt/llama.cpp/{build}/llama-{build}")
    exe = os.path.join(binr, "llama-server")
    if not os.path.isfile(exe):
        return False, f"llama.cpp {build} is not installed at {binr}"
    env = dict(os.environ, LD_LIBRARY_PATH=binr)
    try:
        pr = subprocess.run([exe, "--rpc", f"{ep[0]}:{ep[1]}", "--list-devices"],
                            capture_output=True, text=True, timeout=timeout, env=env, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        end = "phone" if tuple(ep) == PHONE_RPC else "desktop"
        return False, f"llama.cpp hung listing devices over RPC ({end} end not answering within {timeout}s)"
    out = (pr.stdout or "") + (pr.stderr or "")
    if re.search(r"^\s+RPC\d", out, re.M):
        return True, "RPC device present"
    if "crashed or returned malformed response" in out:
        end = "phone" if tuple(ep) == PHONE_RPC else "desktop"  # the same probe serves both forwards
        fix = ("run the serve loop in Termux (gnoc phone setup)" if end == "phone"
               else "Restart rpc-desktop.ps1 on the desktop with that build")
        return False, (f"the port is open but the {end} end is not a working ggml-rpc-server (dead, or built "
                       f"against another llama.cpp: both ends must be {build}). {fix}.")
    return False, "llama.cpp lists no RPC device over the tunnel"


def _rpc_reachable():
    return _rpc_probe()[0]


def _rpc_restart_remote(wait=120):
    """Ask the desktop's keep-alive supervisor to restart its ggml-rpc-server, and wait for it to answer.

    A hung RPC server is still a running process, so the desktop side cannot tell it is broken; only this end
    can (_rpc_probe). The supervisor polls for this flag file every 20s over the SSH key it already holds."""
    flag = os.path.expanduser("~/.cache/greynoc-rpc-restart")
    os.makedirs(os.path.dirname(flag), exist_ok=True)
    with open(flag, "w") as fh:
        fh.write(datetime.now(timezone.utc).isoformat() + "\n")
    print(dim(f"  asked the desktop to restart its RPC server; waiting up to {wait}s"))
    deadline = time.time() + wait
    while time.time() < deadline:
        time.sleep(10)
        if _rpc_probe(timeout=20)[0]:
            print(green("  desktop RPC is serving again"))
            return True
    with contextlib.suppress(OSError):
        os.remove(flag)
    # The supervisor polls FROM the desktop, so when it is dead this end has no way in (the desktop's sshd is
    # firewalled off). Say exactly what to do there instead of naming a repo file the desktop may not even have.
    print(red("  the desktop did not come back") + dim(": its keep-alive supervisor is not running, and it is the "
                                                       "side that reaches in, so nothing here can start it."))
    # The installer (rpc-desktop.ps1) is NOT copied to the desktop; what lives there is the launcher it wrote
    # into Startup plus ~\greynoc-rpc-loop.ps1. Naming the installer sent GreyNOC to a path that does not exist.
    print(dim("  ON THE DESKTOP, either one:") +
          "\n" + dim("    press Win+R, run  shell:startup  and double-click  the user-RPC-Link.cmd") +
          "\n" + dim("    or in PowerShell:  powershell -NoProfile -ExecutionPolicy Bypass -File "
                     "\"$HOME\\greynoc-rpc-loop.ps1\"") +
          "\n" + dim("  then back here:  gnoc split up") +
          "\n" + dim("  (the Ollama link is separate and still up, so the desktop keeps serving the lead model "
                     "either way)"))
    return False


def do_phone(args):
    """gnoc phone [status|up|down|setup|revive|log] - the Android phone over USB (scripts/phone-link).
    gnoc phone link [status|setup|up|down|pull|models] - the same phone the way every install does it
    (scripts/gnoc_phone.py: gnoc's own engine in Termux, reached through adb forward)."""
    import shutil
    sub = args[0] if args else "status"
    # the ssh-managed phone (scripts/phone-link) is one machine's own setup: GNOC_PHONE_LEGACY=1 in its machine.json
    if os.environ.get("GNOC_PHONE_LEGACY", "").strip() != "1" or sub == "link" \
            or not os.path.isfile(os.path.join(WS, "scripts/phone-link/phone_link.py")):
        sys.path.insert(0, os.path.join(WS, "scripts"))
        import gnoc_phone
        sys.exit(gnoc_phone.main(list(args[1:] if sub == "link" else args)))
    link = os.path.join(WS, "scripts/phone-link/phone_link.py")
    if sub == "nas":
        nas = os.path.join(WS, "scripts/phone-link/phone-nas.sh")
        rest = args[1:] or ["status"]
        if rest[0] not in ("mount", "umount", "unmount", "status", "speed", "conf"):
            sys.exit("usage: gnoc phone nas [mount|umount|status|speed]")
        return subprocess.call(["bash", nas] + rest, cwd=WS)
    if sub == "revive":
        r = subprocess.run([sys.executable, link, "--revive"], capture_output=True, text=True, timeout=90)
        try:
            got = json.loads(r.stdout)
        except ValueError:
            sys.exit(red("revive failed: ") + (r.stderr or r.stdout).strip()[-300:])
        print(green("revive: ") + str(got.get("did")) if got.get("ok") else red("revive: ") + str(got.get("why")))
        print(dim("  give the serve loop ~20s, then: gnoc phone status"))
        return
    if sub == "log":
        n = args[1] if len(args) > 1 and args[1].isdigit() else "40"
        sys.path.insert(0, os.path.join(WS, "scripts/phone-link"))
        import phone_link
        rc, out = phone_link.phone_ssh(f"tail -n {n} $HOME/greynoc-phone.log", timeout=25)
        print(out or dim("(empty)") if rc == 0 else red("ssh to the phone failed: ") + out[:200]
              + dim("\n  (the phone side may be dead: gnoc phone revive)"))
        return
    if sub == "up":
        sh(["pm2", "delete", "phone-link"])
        r = subprocess.run(["pm2", "start", link, "--name", "phone-link", "--interpreter", "python3",
                            "--kill-timeout", "4000"], capture_output=True, text=True, cwd=WS)
        print(green("phone-link started (pm2)") if r.returncode == 0 else red(r.stderr.strip()[-300:]))
        _log_change("phone", detail="up")
        sub = "status"
    if sub == "down":
        rc, _, err = sh(["pm2", "stop", "phone-link"])
        print(green("phone-link stopped (the adb forwards stay until the cable is pulled)") if rc == 0 else red(err[:200]))
        return
    if sub == "setup":
        src = os.path.join(WS, "scripts/phone-link/termux-setup.sh")
        adb = shutil.which("adb") or os.path.expanduser("~/.local/bin/adb")
        rc, out, err = sh([adb, "push", src, "/sdcard/Download/greynoc-termux-setup.sh"])
        if rc != 0:
            sys.exit(red("adb push failed: ") + (err or out).strip()[:200] + dim("  (gnoc phone status says why)"))
        print(green("pushed to the phone: Download/greynoc-termux-setup.sh"))
        # The reviver's key. Its own keypair, not the desktop's: this one authorises a shell on the phone and
        # nothing else, and it has no passphrase because pm2 runs the supervisor unattended.
        key = os.path.expanduser("~/.ssh/gnoc-phone")
        if not os.path.exists(key):
            os.makedirs(os.path.dirname(key), exist_ok=True)
            kc, _, kerr = sh(["ssh-keygen", "-t", "ed25519", "-N", "", "-C", "gnoc-phone-link", "-f", key])
            print(green("generated ~/.ssh/gnoc-phone") if kc == 0 else red("ssh-keygen failed: " + kerr[:150]))
        if os.path.exists(key + ".pub"):
            pc, pout, perr = sh([adb, "push", key + ".pub", "/sdcard/Download/gnoc-phone-link.pub"])
            print(green("pushed the reviver key: Download/gnoc-phone-link.pub") if pc == 0
                  else red("key push failed: " + (perr or pout)[:150]))
        print("  in Termux on the phone, run:")
        print("    termux-setup-storage        " + dim("# once: lets Termux read Download"))
        print("    bash ~/storage/downloads/greynoc-termux-setup.sh")
        print(dim("  it installs Ollama, builds llama.cpp b11476's rpc-server (10-20 min) and starts both on the"))
        print(dim("  phone's localhost only. Then here: gnoc phone status, and gnoc split up to use it."))
        return
    if sub != "status":
        sys.exit("usage: gnoc phone [status|up|down|setup|revive|log [n]]")
    r = subprocess.run([sys.executable, link, "--once"], capture_output=True, text=True, timeout=60)
    try:
        st = json.loads(r.stdout)
    except ValueError:
        sys.exit(red("phone-link failed: ") + (r.stderr or r.stdout).strip()[-300:])
    state = st.get("state")
    print(f"  adb      {green(state) if state == 'device' else yellow(str(state))}"
          + (f"  {st.get('model')} (Android {st.get('android')})  serial {st.get('serial')}" if state == "device" else ""))
    if st.get("hint"):
        print(dim(f"           {st['hint']}"))
    if state == "device":
        bat = st.get("battery")
        print(f"  battery  {bat}%{' charging' if st.get('charging') else ''}"
              + (f"  {st.get('battery_c')} C" if st.get("battery_c") else "")
              + f"   memory {st.get('mem_avail_mb')}/{st.get('mem_total_mb')} MB free")
        o = st.get("ollama") or {}
        print("  ollama   127.0.0.1:11441  " + (green(f"up {o.get('version')}") + dim(f"  loaded: {', '.join(o.get('loaded') or []) or 'nothing'}")
                                                if o.get("up") else red("not answering") + dim("  (run the serve loop in Termux: gnoc phone setup)")))
        p_ok, p_why = _rpc_probe(timeout=15, ep=PHONE_RPC)
        print(f"  rpc      127.0.0.1:{PHONE_RPC[1]}  " + (green("serving (b11476)") if p_ok else red("not serving") + dim(f"  ({p_why})")))
        ssh = st.get("ssh") or {}
        print("  ssh      127.0.0.1:8022  " + (green("up") + dim("  (phone-link can revive the serve loop)")
                                               if ssh.get("up") else
                                               yellow("no") + dim(f"  ({ssh.get('err') or 'not answering'};"
                                                                  " phone-link falls back to am start)")))
        nas = st.get("nas") or {}
        if nas:
            print("  nas      " + (green(f"mounted {nas.get('mount')}") if nas.get("up")
                                   else yellow("not mounted") + dim(f"  ({nas.get('why') or nas.get('last') or ''}"
                                                                   f"{'; retry in %ss' % nas['retry_in_s'] if nas.get('retry_in_s') else ''})")))
        rv = st.get("revive") or {}
        if rv.get("attempts"):
            print(dim(f"  revive   {rv['attempts']} attempt(s), last {rv.get('at')}: {rv.get('last')}"
                      f"  next in {rv.get('next_in_s')}s"))
    procs = json.loads(sh(["pm2", "jlist"])[1] or "[]")
    pst = next((p["pm2_env"]["status"] for p in procs if p.get("name") == "phone-link"), "not created")
    print(f"  pm2      phone-link {pst}" + ("" if pst == "online" else dim("  (gnoc phone up keeps the forwards alive)")))


def do_split(args):
    """gnoc split [status|up [ollama-model]|down] - ONE model across BOTH GPUs (laptop RX 7700S + desktop GPU
    over llama.cpp RPC), served at 127.0.0.1:11450 for `gnoc chat`, which then uses it for lead AND worker.
    Desktop side, once: scripts/desktop-link/rpc-desktop.ps1. Laptop side: scripts/split-llm.sh under pm2."""
    import contextlib
    import urllib.request
    sub = args[0] if args else "status"
    url = "http://127.0.0.1:11450/health"
    if sub == "status":
        try:
            procs = json.loads(sh(["pm2", "jlist"])[1] or "[]")
        except ValueError:
            procs = []
        st = next((p["pm2_env"]["status"] for p in procs if p.get("name") == "split-llm"), "not created")
        try:
            healthy = b"ok" in urllib.request.urlopen(url, timeout=2).read()
        except Exception:
            healthy = False
        # A HEALTHY split server proves the RPC is serving: the model is running on it. The probe below asks
        # llama.cpp to list devices, which needs its OWN connection, and the running server already holds one -
        # so while the split was UP the probe said "NOT serving" and told GreyNOC to go restart the desktop
        # script (measured 2026-10-22). Only ask when there is nothing running to vouch for it.
        if healthy:
            rpc_ok, rpc_why = True, "in use by the split server"
        else:
            rpc_ok, rpc_why = _rpc_probe()
        print(f"  desktop RPC 127.0.0.1:{SPLIT_RPC[1]}  {green('serving') if rpc_ok else red('NOT serving')}"
              + (dim(f"  ({rpc_why})") if rpc_ok and healthy else "" if rpc_ok else dim(f"  ({rpc_why})")))
        if healthy:
            joined = "127.0.0.1:50053" in read(os.path.expanduser("~/.pm2/logs/split-llm-out.log"))[-20000:]
            print(f"  phone RPC 127.0.0.1:{PHONE_RPC[1]}    " + (green("in the split") if joined else dim("not in this split")))
        else:
            p_ok, p_why = _rpc_probe(timeout=15, ep=PHONE_RPC)
            print(f"  phone RPC 127.0.0.1:{PHONE_RPC[1]}    " + (green("serving") if p_ok else dim(f"not serving ({p_why})")))
        # Not every stopped split is a crash loop, and calling one that is not sends you hunting the wrong
        # thing. split-llm.sh exits 3 when the desktop RPC is unusable and pm2 stop_exit_codes parks it for
        # good - restart_time stays put and pm2 still LABELS that "waiting restart". A real loop is the one
        # with a climbing restart count.
        rt = next((p["pm2_env"].get("restart_time", 0) for p in procs if p.get("name") == "split-llm"), 0)
        if st in ("waiting restart", "errored", "stopped"):
            note = ("  (crash-looping: see ~/.pm2/logs/split-llm-error.log)" if rt > 3
                    else f"  (not running, {rt} restarts; reason in ~/.pm2/logs/split-llm-error.log)")
        else:
            note = ""
        print(f"  pm2 split-llm         {st}" + dim(note))
        print(f"  server {url[:-7]}  {green('ready') if healthy else yellow('not ready')}")
        if os.path.exists(os.path.join(WS, ".claude/state/orch/SPLIT.enabled")) and not healthy:
            print(red("  gnoc chat is NOT on the split model") + dim(": the flag is set but the server is not "
                  "answering, so lead and worker fall back to their own models (gnoc split down to clear)"))
        dlog = os.path.expanduser("~/.cache/greynoc-rpc-desktop.log")
        if not rpc_ok and not healthy and os.path.isfile(dlog):
            # shipped back by the desktop's keep-alive supervisor when it finds the RPC server dead
            print(dim(f"    desktop RPC crash log ({time.strftime('%Y-%m-%d %H:%M', time.localtime(os.path.getmtime(dlog)))}):"))
            for line in [l for l in read(dlog).splitlines() if l.strip()][-6:]:
                print(dim("      " + line.strip()[:150]))
        log = os.path.expanduser("~/.pm2/logs/split-llm-out.log")
        for line in read(log).splitlines()[-200:]:
            if "devices" in line or "load_tensors" in line and "buffer size" in line:
                print(dim("    " + line.strip()[:150]))
        return
    flag = os.path.join(WS, ".claude/state/orch/SPLIT.enabled")
    if sub == "down":
        with contextlib.suppress(OSError):
            os.remove(flag)
        rc, _, err = sh(["pm2", "stop", "split-llm"])
        print(green("split-llm stopped") if rc == 0 else red(err.strip()[:200]))
        _log_change("split", detail="down")
        return
    if sub == "restart-remote":
        _rpc_restart_remote()
        return
    if sub != "up":
        sys.exit("usage: gnoc split [status|up [ollama-model]|down|restart-remote]")
    # A running split-llm holds the desktop's ggml-rpc-server, which takes ONE client: probing past it reads as
    # "the desktop end is dead", and `split up` (to change model or flags) then asked the desktop to restart a
    # healthy server and gave up (2026-10-24). Stop ours first; the restart below replaces it anyway.
    procs = json.loads(sh(["pm2", "jlist"])[1] or "[]")
    if any(p.get("name") == "split-llm" and p["pm2_env"].get("status") == "online" for p in procs):
        print(dim("  split-llm is running: stopping it first (it holds the desktop's only RPC connection)"))
        sh(["pm2", "stop", "split-llm"])
        time.sleep(3)
    rpc_ok, rpc_why = _rpc_probe()
    if not rpc_ok:
        # try the control channel before sending anyone to the desktop: a hung remote is the common case
        print(yellow("the desktop's RPC server is not answering: ") + rpc_why)
        rpc_ok = _rpc_restart_remote()
    if not rpc_ok:
        print(red(f"the desktop's RPC server is not usable at 127.0.0.1:{SPLIT_RPC[1]}: ") + rpc_why)
        print(dim("  on the desktop, once (PowerShell):"))
        print(dim("    powershell -ExecutionPolicy Bypass -File .\\rpc-desktop.ps1 -Laptop <this-laptop-ip>"))
        print(dim("  (copy scripts/desktop-link/rpc-desktop.ps1 over; same SSH key as link-desktop.ps1)"))
        return
    pos = [a for a in args[1:] if not a.startswith("--")]
    name = pos[0] if pos else SPLIT_DEFAULT_MODEL
    import llm_endpoints
    if not llm_endpoints.allow_stock() and llm_endpoints.stock(name, "local"):
        sys.exit(f"{name} is a stock (censored) model; gnoc runs uncensored models only "
                 "(an abliterated/uncensored build, or GNOC_ALLOW_STOCK=1)")
    blob = _ollama_blob(name)
    if not blob or not os.path.isfile(blob):
        sys.exit(f"{name} is not in the laptop's ollama-oc store (gnoc models; gnoc models pull <owner/repo>)")
    try:  # free the desktop card: anything in its Ollama competes with the RPC server for the same VRAM
        dl = [m["name"] for m in (_http_json(f"http://{DESKTOP_OLLAMA}/api/ps", 3).get("models") or [])]
    except Exception:
        dl = []
    for m in dl:
        req = urllib.request.Request(f"http://{DESKTOP_OLLAMA}/api/generate",
                                     json.dumps({"model": m, "keep_alive": 0}).encode(),
                                     {"Content-Type": "application/json"})
        with contextlib.suppress(Exception):
            urllib.request.urlopen(req, timeout=30).read()
        print(dim(f"  unloaded {m} from the desktop GPU"))
    try:  # the laptop card must be empty: Ollama keeps models resident for 30 min
        loaded = [m["name"] for m in (_http_json(f"{OLLAMA}/api/ps", 3).get("models") or [])]
    except Exception:
        loaded = []
    for m in loaded:
        req = urllib.request.Request(f"{OLLAMA}/api/generate", json.dumps({"model": m, "keep_alive": 0}).encode(),
                                     {"Content-Type": "application/json"})
        with contextlib.suppress(Exception):
            urllib.request.urlopen(req, timeout=30).read()
        print(dim(f"  unloaded {m} from the laptop GPU"))
    rpc_list = [f"{SPLIT_RPC[0]}:{SPLIT_RPC[1]}"]
    if "--no-phone" not in args:
        p_ok, p_why = _rpc_probe(timeout=20, ep=PHONE_RPC)
        if p_ok:
            rpc_list.append(f"{PHONE_RPC[0]}:{PHONE_RPC[1]}")
            print(green("  the phone joins the split") + dim(" (RPC1 over USB; it holds the layers the GPUs cannot. "
                                                           "It adds a USB round trip per token: compare with --no-phone)"))
        else:
            print(dim(f"  phone not in this split: {p_why}"))
    env = dict(os.environ, SPLIT_MODEL=blob, SPLIT_ALIAS="split", SPLIT_RPC=",".join(rpc_list))
    # Start from a pm2 ecosystem file, not CLI flags, for ONE setting: min_uptime, which pm2 7.x accepts
    # only in a config file (`pm2 start --min-uptime` is "unknown option"). It is what makes max_restarts
    # real. pm2 limits max_restarts on the UNSTABLE counter, and a restart counts as unstable only when
    # the process died inside min_uptime, default 1s. This server loads for ~30s and then dies on the
    # first request after the desktop's ggml-rpc-server goes away, so every crash looked like a healthy
    # restart: unstable_restarts stayed 0, max_restarts never fired, and pm2 relaunched it 3431 times
    # (measured 2026-10-26). 5 min is longer than any load-then-die cycle and far shorter than a real
    # session, so a working split is never flagged. The env is baked into the file as well, so a
    # `pm2 resurrect` at boot carries the model and RPC list instead of inheriting whatever shell saved it.
    cfg = os.path.expanduser("~/.cache/greynoc-split-llm.pm2.json")
    os.makedirs(os.path.dirname(cfg), exist_ok=True)
    with open(cfg, "w") as fh:
        json.dump({"apps": [{
            "name": "split-llm",
            "script": os.path.join(WS, "scripts/split-llm.sh"),
            "interpreter": "bash",
            "cwd": WS,
            "autorestart": True,
            "kill_timeout": 8000,
            "max_restarts": 3,
            "min_uptime": 300000,
            "restart_delay": 20000,
            # The real guard. split-llm.sh exits 3 when the desktop's ggml-rpc-server is not usable, and
            # stop_exit_codes makes pm2 stop for good on that code instead of retrying: a dead desktop is
            # not something a relaunch can fix. max_restarts/min_uptime above are only a backstop for
            # OTHER failures, and they are weak - pm2 folds restart_delay into the uptime it measures, so
            # the unstable counter this limits resets itself after a cycle or two (watched it go 1, 2, 0
            # on 2026-10-26). Do not rely on them alone.
            "stop_exit_codes": [3],
            "env": {k: v for k, v in env.items() if k.startswith("SPLIT_") or k in ("PATH", "HOME")},
        }]}, fh, indent=2)
    sh(["pm2", "delete", "split-llm"])
    r = subprocess.run(["pm2", "start", cfg], capture_output=True, text=True, cwd=WS, env=env)
    if r.returncode != 0:
        sys.exit(red(f"pm2 start failed: {r.stderr.strip()[-300:]}"))
    with open(flag, "w") as fh:  # while this exists gnoc chat never loads a model on the desktop's Ollama
        fh.write(datetime.now(timezone.utc).isoformat() + f" {name}\n")
    _log_change("split", detail=f"up {name}")
    print(green(f"split-llm starting: {name}"))
    print(dim("  the first start ships the desktop's share of the weights over the tunnel (a few minutes); the"))
    print(dim("  desktop caches them, later starts are fast."))
    # Watch it come up instead of assuming. A flag left behind by a server that never started makes gnoc chat
    # fall back to the laptop model while LOOKING like it is on the split: that silence is the bug.
    wait = int(os.environ.get("SPLIT_WAIT_S", "180"))
    deadline = time.time() + wait
    last = ""
    while time.time() < deadline:
        time.sleep(5)
        try:
            if b"ok" in urllib.request.urlopen(url, timeout=2).read():
                print(green(f"  ready: gnoc chat now runs lead AND worker on {name}"))
                return
        except Exception:
            pass
        try:
            procs = json.loads(sh(["pm2", "jlist"])[1] or "[]")
            st = next((p["pm2_env"]["status"] for p in procs if p.get("name") == "split-llm"), "?")
        except ValueError:
            st = "?"
        if st in ("errored", "waiting restart"):
            err = read(os.path.expanduser("~/.pm2/logs/split-llm-error.log")).strip().splitlines()
            why = next((x for x in reversed(err) if x.strip()), "")
            with contextlib.suppress(OSError):
                os.remove(flag)
            print(red("  split-llm is not starting") + dim(f" ({st})"))
            if why:
                print(dim("    " + why[:200]))
            print(dim("    flag cleared, so gnoc chat keeps using your configured models instead of pretending "
                      "to be on the split. Fix the desktop end, then gnoc split up again."))
            return
        if st != last:
            last = st
            print(dim(f"  {st}..."))
    print(yellow(f"  still loading after {wait}s") + dim("  (big models take a while on the first start; "
          "gnoc split status shows progress, and gnoc chat switches over by itself once it is ready)"))


def _chat_version():
    """gnoc chat -v: the workspace commit it runs from, so a saved session can say what built it."""
    try:
        out = subprocess.run(["git", "-C", WS, "describe", "--always", "--dirty"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return f"gnoc chat {out.stdout.strip()} ({os.path.relpath(WS, os.path.expanduser('~'))})"
    except Exception:  # no git, or git without the repo: the fallback line is enough
        pass
    return "gnoc chat (no version tag; " + os.path.relpath(WS, os.path.expanduser("~")) + ")"


def _parse_chat_flags(args):
    """Parse the `gnoc chat` command line, deepcode-style. Returns a dict (message, exec, prompt,
    resume, fork, skip, offline, plain, repo); exits with a usage line on a bad combination."""
    flags = {"message": None, "exec": False, "prompt": None, "resume": None, "fork": None,
             "skip": False, "offline": False, "plain": False, "repo": None}
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-s-p", "--skip-permissions", "--dangerously-skip-permissions"):
            flags["skip"] = True
        elif a == "--offline":
            flags["offline"] = True
        elif a in ("--plain", "--talk"):
            flags["plain"] = True
        elif a in ("-c", "--continue", "-l", "--last"):  # every launch is new; these pick up the last one
            if flags["resume"]:
                sys.exit(red("usage: pick one of -c / -l / -r <id>"))
            flags["resume"] = "last"
        elif a in ("-p", "--prompt"):
            if flags["prompt"] is not None:
                sys.exit(red("usage: -p may be given once"))
            if i + 1 >= len(args) or args[i + 1].startswith("-"):
                sys.exit(red(f"usage: {a} <prompt>   (the prompt text is missing)"))
            flags["prompt"], i = args[i + 1], i + 2
            continue
        elif a in ("-x", "--exec"):
            flags["exec"] = True
        elif a in ("-r", "--resume"):
            if flags["resume"] is not None:
                sys.exit(red("usage: pick one of -c / -l / -r <id>"))
            if i + 1 < len(args) and not args[i + 1].startswith("-"):
                flags["resume"], i = args[i + 1], i + 2
            else:
                flags["resume"] = ""  # bare -r: the session picker
                i += 1
            continue
        elif a in ("-f", "--fork"):
            if flags["fork"] is not None:
                sys.exit(red("usage: -f may be given once"))
            if i + 1 < len(args) and not args[i + 1].startswith("-"):
                flags["fork"], i = args[i + 1], i + 2
            else:
                flags["fork"] = "last"  # bare -f: fork the most recent saved conversation
                i += 1
            continue
        elif a == "--repo":
            if i + 1 >= len(args):
                sys.exit(red("usage: gnoc chat --repo <path|url|owner/repo> [\"message\"]"))
            flags["repo"], i = args[i + 1], i + 2
            continue
        else:
            rest.append(a)
        i += 1
    if flags["resume"] is not None and flags["fork"] is not None:
        sys.exit(red("usage: pick one of -r / -f"))
    flags["message"] = " ".join(rest) if rest else None
    if flags["prompt"] is not None and flags["message"]:
        sys.exit(red("usage: give the prompt either with -p or as the message, not both"))
    if flags["exec"] and flags["prompt"] is None and flags["message"] is None:
        sys.exit(red("usage: gnoc chat -x -p <prompt>   (-x runs one prompt non-interactively and needs one)"))
    return flags


def _pick_session():
    """Bare `gnoc chat -r`: print the saved conversations and read a number (terminal only)."""
    import gnoc_agent
    rows = gnoc_agent.list_sessions(20)
    if not rows:
        sys.exit("no saved conversations yet (a chat saves itself after its first exchange)")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        sys.exit("usage: gnoc chat -r <number|id-prefix>   (a bare -r needs a terminal for the picker)")
    print(bold("saved conversations:"))
    for i, r in enumerate(rows, 1):
        prog = " " + dim("[" + r["program"] + "]") if r.get("program") else ""
        print(f"  {yellow(str(i)):>4}  {r['title']}{prog}" + dim(f"  ({r['n']} msgs, "
                                                                f"{r['updated'][:16].replace('T', ' ')})"))
    try:
        n = input(bold("resume which? [1] ")).strip() or "1"
    except (EOFError, KeyboardInterrupt):
        print()
        sys.exit(1)
    if n.isdigit() and 1 <= int(n) <= len(rows):
        return rows[int(n) - 1]["sid"]
    hit = next((r["sid"] for r in rows if r["sid"].startswith(n)), None)
    if hit:
        return hit
    sys.exit(red(f"no saved conversation matches {n!r}"))


def _stdin_context(prompt):
    """`cat log | gnoc chat -x -p "explain"`: piped stdin rides along as context for the one prompt."""
    try:
        data = sys.stdin.read()
    except Exception:  # a weird stdin must not eat the prompt
        return prompt
    data = data.strip()
    return f"{prompt}\n\n<context from stdin>\n{data[:50000]}" if data else prompt


def do_chat(args):
    """gnoc chat [flags] ["message" | "/command ..."]   |   gnoc chat   (interactive)
    The two-GPU hunt agent (scripts/gnoc_agent.py): talk to it like Claude Code, it uses real tools
    (files, shell, scope-gated HTTP, hunt index, gnoc, the background bot, Claude workers) and can
    hunt continuously (/hunt). `gnoc chat --simple ...` (or /simple) is the old read-only status Q&A.

    deepcode-style flags (the colorful REPL and banner stay):
      -p, --prompt <text>   submit <text> on launch and stay in the REPL
      -x, --exec            run one prompt non-interactively (needs -p, or a plain message)
      -r, --resume [id]     resume a saved conversation (a /sessions number or id prefix);
                            bare -r shows the session picker
      -f, --fork [id]       fork a saved conversation into a new one (bare -f = the most recent)
      -l, --last            resume the most recent conversation for this terminal (same as -c)
      -v, --version         print the version and exit
      cat log | gnoc chat -x -p "explain this"   piped stdin is attached as context
    gnoc flags: -s-p  --repo <path|url|owner/repo>  --offline  -c/--continue  --plain  --simple
    Collaborator project: launched in a folder with the partner's initial HANDOFF*.md (or kickoff /
    onboarding / SCOPE / AUTHORIZATION / ROE / SOW paperwork), that document IS the scope: gnoc chat
    imports it automatically, enters no hunt stance, and needs no bug-bounty program. /collab shows
    the handoff and its hosts; /collab refresh re-reads it after an edit.
    Every new conversation starts clean: program clear, unlimited steps (/effort steps 0), mode auto."""
    if args[:1] == ["--simple"] or os.environ.get("GNOC_CHAT_SIMPLE") == "1":
        return do_chat_simple(args[1:] if args[:1] == ["--simple"] else args)
    if args[:1] in (["-h"], ["--help"]):  # usage, not a message for the model (it used to answer "--help")
        print(do_chat.__doc__)
        return 0
    if args[:1] in (["-v"], ["--version"]):
        print(_chat_version())
        return 0
    parsed = _parse_chat_flags(args)
    import gnoc_agent
    if parsed["resume"] == "":  # bare -r: the picker picks, then the chat resumes it
        parsed["resume"] = _pick_session()
    prompt = parsed["prompt"] or parsed["message"]
    one_shot, staged = None, None
    if parsed["exec"]:
        one_shot = prompt
        if not sys.stdin.isatty():  # piped stdin rides along, exactly like deepcode -x
            one_shot = _stdin_context(one_shot)
    elif parsed["prompt"] is not None:
        staged = parsed["prompt"]  # -p alone: open the REPL with the prompt already staged
    elif parsed["message"] is not None:
        one_shot = parsed["message"]
    # Commands the agent itself does not handle. /model and /route are the agent's (these handlers write the
    # simple chat's chat-session.json, which the agent never reads), so they are not here; /stophunt keeps the
    # agent's own lead and worker loaded, and /simple asks the agent's lead, for the same reason.
    def _agent_models():
        return [_spec_split(gnoc_agent.role_spec(r))[0] for r in ("lead", "worker")]

    def _simple(rest):
        if not rest:
            print(red("  usage: /simple <question>   (one read-only status question to the lead model)"))
            return
        do_chat_simple(rest, spec=gnoc_agent.role_spec("lead"))

    def _stop(rest):
        # The goal's own hint said "(/stop off, then /goal resume)" while no /stop existed: he typed "/stop OFF" and
        # got "unknown command /stop" (2026-11-27). /stop off is /resumehunt; /stop on is /stophunt; bare /stop
        # only says where STOP stands, because killing every hunt process is never a default.
        arg = (rest[0].lower() if rest else "")
        if arg in ("off", "clear", "resume", "no", "0", "false"):
            do_resumehunt()
        elif arg in ("on", "set", "yes", "1", "true"):
            do_stophunt(rest[1:], keep=_agent_models())
        else:
            p = os.path.join(STATE, "STOP")
            print(("global STOP is " + yellow("SET") + dim(f"  ({open(p).read().strip()[:60]})"))
                  if os.path.exists(p) else "global STOP is not set")
            print(dim("  /stop off clears it (same as /resumehunt)  ·  /stop on sets it and stops hunting "
                      "(same as /stophunt)"))

    legacy = {"clone": do_clone, "bots": do_bots_cmd,
              "stophunt": lambda _rest=None: do_stophunt(_rest, keep=_agent_models()),
              "resumehunt": do_resumehunt, "stop": _stop, "simple": _simple}
    gnoc_agent.repl(legacy, one_shot=one_shot, repo=parsed["repo"], skip_perms=parsed["skip"],
                    offline_mode=parsed["offline"], resume=parsed["resume"], plain=parsed["plain"],
                    fork=parsed["fork"], staged_prompt=staged)


def do_collab(args):
    """gnoc collab [status|list|import [dir|file]|refresh <handle>]

    A collaborator engagement: the partner's INITIAL HANDOFF document is the scope - no bug-bounty
    program, platform export or targets/<handle>/SCOPE.txt from a platform. `import` reads a project's
    handoff (Markdown/text/PDF/DOCX), parses its explicit in-scope and out-of-scope hosts and writes a
    local engagement profile under targets/collab-<project>/. `refresh` re-reads it after an edit.
    `gnoc chat` does the import automatically when launched in the project.
    """
    sys.path.insert(0, os.path.join(WS, "scripts"))
    import gnoc_collab
    action = (args[0] if args else "status").lower()
    rest = args[1:]
    if action in ("status", "list"):
        rows = gnoc_collab.all_profiles(WS)
        if not rows:
            print(dim("  no collaborator engagements imported"))
            print(dim("  open gnoc chat in the project, or: gnoc collab import <dir>"))
            return 0
        for row in rows:
            print(gnoc_collab.summary(row["program"], WS))
            print()
        return 0
    if action in ("import", "add"):
        target = os.path.realpath(os.path.expanduser(rest[0] if rest else os.getcwd()))
        if os.path.isfile(target):
            got = gnoc_collab.import_handoff(os.path.dirname(target), WS, handoff_path=target)
        else:
            got = gnoc_collab.import_handoff(target, WS)
        if not got.get("ok"):
            print(red("  collab import failed: ") + str(got.get("reason")))
            print(dim("  the initial handoff may be named HANDOFF*.md / kickoff / onboarding, or be the "
                      "SCOPE/AUTHORIZATION/ROE/SOW paperwork; PDF and DOCX are read too"))
            return 1
        print(green("● ") + f"collaborator engagement -> {got['program']}")
        print(gnoc_collab.summary(got["program"], WS))
        if not got.get("hosts"):
            print(yellow("  WARNING: the handoff had no explicit scope section; no request can pass yet."))
        return 0
    if action in ("refresh", "reload"):
        if not rest:
            print(red("  usage: gnoc collab refresh <handle>   (gnoc collab lists the handles)"))
            return 2
        got = gnoc_collab.refresh(rest[0], WS)
        if not got.get("ok"):
            print(red("  collab refresh failed: ") + str(got.get("reason")))
            return 1
        print(gnoc_collab.summary(got["program"], WS))
        return 0
    if action in ("help", "-h", "--help"):
        print(do_collab.__doc__)
        return 0
    print(red(f"  unknown collab action: {action}")
          + dim("  (status|list|import [dir|file]|refresh <handle>)"))
    return 2


def do_graph(args):
    """gnoc graph [overview|stats|assets|coverage|nodes|todos|traces|traffic|evidence|findings|retest|rules|snapshot|diff|path|lineage|draft|export|programs] [program] [query]

    The ARTEX-style dual graph: the global asset graph (hosts/endpoints, deduplicated and
    program-associated) and the per-program exploration graph (goal/intent/fact/finding nodes
    anchored to assets), plus coverage, durable planning todos, searchable worker traces,
    deduplicated evidence and the findings lifecycle.
    `gnoc graph export [program] [--out PATH] [--open]` writes the visual cockpit: one
    self-contained HTML page (no network) with the graph, coverage, findings, todos and approvals.
    `gnoc graph snapshot`/`diff` show the attack surface moving; `path`/`lineage` walk the exploration
    graph; `traffic` lists, searches and shows every captured exchange (hosts, show <id>, purge);
    `stats` prints the dashboard numbers; `retest`/`retests` schedule and close re-tests; `rules`
    lists the operator's bounded approval rules.
    `gnoc graph draft <program> <finding_id>` writes a REPORT-FORMAT report draft for a confirmed
    finding (report.md + GATES.md + the cited raw captures). It files nothing.
    No program argument uses the current global LOCK.
    """
    sys.path.insert(0, os.path.join(WS, "scripts"))
    import gnoc_graph
    gnoc_graph.WS = WS
    gnoc_graph.DB_PATH = os.path.join(WS, ".claude/state/graph/gnoc_graph.db")
    action = (args[0].lower() if args else "overview")
    if action not in ("programs", "list"):
        # a leading flag (export --open) must not be mistaken for the program handle; the program
        # handle goes right after the action, never appended after flags
        second = args[1] if len(args) > 1 else ""
        if not second or second.startswith("-"):
            lock = read(os.path.join(STATE, "LOCK")).strip().splitlines()
            cur = next((ln.split()[0] for ln in lock if ln.strip() and not ln.startswith("#")), "")
            if cur:
                args = [args[0], cur] + list(args[1:])
    return gnoc_graph._main(list(args))


def do_approvals(args):
    """gnoc approvals [list [state] | show <id> | approve <id> [reason] | deny <id> [reason]]

    The intercept approval queue: a non-interactive gnoc turn that needs the user's yes records the
    exact tool call here instead of silently refusing. `approve` makes that exact call runnable once,
    until it expires; `deny` is final. Inside chat: /approvals, /approve <id>, /deny <id>.
    """
    sys.path.insert(0, os.path.join(WS, "scripts"))
    import gnoc_graph
    gnoc_graph.WS = WS
    gnoc_graph.DB_PATH = os.path.join(WS, ".claude/state/graph/gnoc_graph.db")
    action = (args[0].lower() if args else "list")
    rest = args[1:]
    if action in ("list", "ls"):
        state = rest[0] if rest else "pending"
        print(gnoc_graph.approvals_text(None, state=state))
        return 0
    if action in ("show", "get"):
        if not rest or not rest[0].isdigit():
            print(red("  usage: gnoc approvals show <id>"))
            return 2
        row = gnoc_graph.approval_get(int(rest[0]))
        if not row:
            print(red(f"  no approval #{rest[0]}"))
            return 1
        for key in ("id", "state", "program", "action", "summary", "risk", "requested_by", "decided_by",
                    "reason", "created_at", "decided_at", "expires_at", "used_at"):
            print(f"  {key:<12} {row.get(key) or '-'}")
        print("  payload:")
        print("    " + str(row.get("payload") or ""))
        return 0
    if action in ("approve", "deny"):
        if not rest or not rest[0].isdigit():
            print(red(f"  usage: gnoc approvals {action} <id> [reason]"))
            return 2
        reason = " ".join(rest[1:]).strip()
        try:
            row = gnoc_graph.approval_decide(int(rest[0]), approve=(action == "approve"), program=None,
                                             decided_by="operator", reason=reason)
        except Exception as e:  # noqa: BLE001
            print(red(f"  approval failed: {type(e).__name__}: {str(e)[:300]}"))
            return 1
        if row["state"] == "approved":
            print(green(f"  approval #{row['id']} approved (single use, until {row['expires_at']})"))
            print(dim("  the model can retry that exact call now"))
        elif row["state"] == "denied":
            print(red(f"  approval #{row['id']} denied") + (dim(f"  {row['reason']}") if row.get("reason") else ""))
        elif row["state"] == "expired":
            print(red(f"  approval #{row['id']} expired before a decision"))
        else:
            print(yellow(f"  approval #{row['id']} is already {row['state']}"))
        return 0
    print(red(f"  unknown approvals action: {action}")
          + dim("  (list [state] | approve <id> [reason] | deny <id> [reason])"))
    return 2


