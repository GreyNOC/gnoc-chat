DEFAULT_SOAK = [
    "hello, what are you tracking right now?",
    "read SPINE.md and tell me the gates in order, briefly",
    "how is the site looking?",
    "find the file that defines the office funnel stages and tell me the stage names",
    "what changed in this repo in the last three commits? use git and summarise each",
    "search the hunt index for gatewayco and summarise in five lines what we already know",
    "run the test suite file scripts/test_gnoc_oast.py and tell me how many passed",
    "read targets/program-32/TARGET-MODEL.md and tell me which trust boundary is weakest and why",
]


def do_soak(args):
    """`gnoc soak [name] [-f prompts.txt] [-t secs] [--chain] [--report]` - drive the chat bot with real
    prompts and flag anything that looks like a defect rather than an answer.

    --chain makes the prompts turns in ONE conversation instead of separate cold starts, which is the
    only way to exercise history, sticky tools and a goal that has to survive several turns.
    --report prints every batch in the current directory as one table and runs nothing.

    This is the battery that found the overnight fixes on 2026-10-25 (tilde paths, empty turns,
    find_file, the misrouted command, the worker wall, the root grep). Rows land in <name>.jsonl in
    the current directory; flagged runs print with the line that triggered them. A flag is a LEAD,
    not a verdict: read the row before calling anything a defect."""
    name = "soak"
    prompts, timeout, flags = None, None, []
    rest = list(args)
    while rest:
        a = rest.pop(0)
        if a in ("-f", "--prompts") and rest:
            prompts = rest.pop(0)
        elif a in ("-t", "--timeout") and rest:
            timeout = rest.pop(0)
        elif a in ("-h", "--help"):
            print(do_soak.__doc__)
            return 0
        elif a in ("--chain", "--report"):
            flags.append(a)
        elif not a.startswith("-"):
            name = a
    env = dict(os.environ)
    if timeout:
        env["SOAK_TIMEOUT"] = str(timeout)
    driver = os.path.join(WS, "scripts/learn/soak.py")
    if not os.path.exists(driver):
        print(red(f"missing driver: {driver}"), file=sys.stderr)
        return 2
    if "--report" in flags:   # reads the rows already on disk; drives nothing
        return subprocess.run([sys.executable, "-u", driver, "--report"], env=env).returncode
    body = open(prompts).read() if prompts else "\n".join(DEFAULT_SOAK) + "\n"
    print(dim(f"soaking with {len(body.strip().splitlines())} prompt(s); rows -> {name}.jsonl"
              + ("; chained into one conversation" if "--chain" in flags else "")))
    p = subprocess.run([sys.executable, "-u", driver, name] + flags, input=body, text=True, env=env)
    return p.returncode


def do_export(args):
    """`gnoc export trajectories|batch` - in this process, not passthrough(): passthrough runs in WS, so a relative
    --out landed in the install folder and a batch's agents worked there instead of where it was typed."""
    import gnoc_trajectories
    return gnoc_trajectories.main(args)


def do_gpus(args):
    """`gnoc gpus` - what the agent tells you to run when a model will not start.

    It said "gnoc gpus to check the desktop" in three places while no such command existed
    (measured 2026-10-25), so the advice sent you to an unknown-command error. This is that view:
    each role and where it resolves, every llm host and whether it answers, what each has loaded,
    and the local GPUs from sysfs."""
    import glob as _glob
    import json as _json
    import urllib.request as _url
    sys.path.insert(0, os.path.join(WS, "scripts"))
    import llm_endpoints as L
    print(bold("ROLES"))
    try:
        roles = L.roles()
    except Exception as e:
        roles, _ = {}, print(f"  (roles unreadable: {e})")
    for role in ("lead", "worker", "brain", "hunter"):
        spec = roles.get(role)
        if not spec:
            continue
        try:
            name, host = L.split(spec)
        except Exception:
            name, host = spec, "?"
        print(f"  {role:8} {name}  @{host}")
    if not any(roles.get(r) for r in ("lead", "worker", "brain", "hunter")):
        print(dim("  none set yet: run  gnoc setup"))
    print()
    print(bold("HOSTS"))
    for host, addr in sorted(getattr(L, "HOSTS", {}).items()):
        if not addr:
            continue   # a link this install does not have (a public install has no desktop or phone)
        up = False
        try:
            up = bool(L.sniff(host, 2.0))   # asked, never assumed: "local" was printed "up" with nothing there
        except Exception:
            up = False
        loaded = []
        try:
            with _url.urlopen(f"http://{addr}/api/ps", timeout=3) as r:
                loaded = [m.get("name") for m in (_json.load(r).get("models") or [])]
        except Exception:
            pass
        mark = green("up  ") if up else red("down")
        print(f"  {host:9} {addr:24} {mark}  loaded: {', '.join(m for m in loaded if m) or dim('none')}")
    print()
    # The desktop card is NOT in sysfs (it is a Windows box at the end of a tunnel), and it is the card
    # that actually fails: the lead model and ComfyUI share it. 2026-10-25, after one SDXL render, a dead
    # llama-server still listed in /api/ps held the VRAM and every chat turn stalled for minutes.
    if not getattr(L, "HOSTS", {}).get("desktop"):
        return _local_gpus(_glob)
    print(bold("DESKTOP CARD (via ComfyUI)"))
    try:
        sys.path.insert(0, os.path.join(WS, "scripts"))
        import gnoc_image as _img
        vram, ram = _img._desktop_free()
    except Exception as e:
        vram, ram = None, None
        print(dim(f"  unreadable: {e}"))
    if vram is not None:
        line = f"  vram free {vram:.1f} GB   ram free {ram:.1f} GB"
        print(line if vram >= _img.MIN_FREE_VRAM_GB else line + red("   TOO FULL for the lead model"))
        if vram < _img.MIN_FREE_VRAM_GB:
            print(red("  a model listed as loaded above may be a runner that CRASHED and is still holding "
                      "the card."))
            print(red("  free it:") + "  python3 -c \"import sys; sys.path.insert(0,'scripts'); "
                  "import gnoc_image; print(gnoc_image.restore_gpu())\"")
        if ram is not None and ram < _img.LOW_DESKTOP_RAM_GB:
            # 2026-10-25: a llama-server Ollama no longer listed held 13 GB of the desktop's 15.7 GB RAM.
            print(red(f"  desktop RAM under {_img.LOW_DESKTOP_RAM_GB:.0f} GB: a runner Ollama forgot may be holding it."))
            print(red("  sweep it:") + "  python3 -c \"import sys; sys.path.insert(0,'scripts'); "
                  "import gnoc_image; print(gnoc_image.free_orphan_runners())\"")
    print()
    return _local_gpus(_glob)


def _local_gpus(_glob):
    print(bold("LOCAL GPUS"))
    found = False
    for card in sorted(_glob.glob("/sys/class/drm/card*/device")):
        busy = os.path.join(card, "gpu_busy_percent")
        if not os.path.exists(busy):
            continue
        found = True
        def _rd(p, d="?"):
            try:
                return open(p).read().strip()
            except OSError:
                return d
        used = _rd(os.path.join(card, "mem_info_vram_used"), "0")
        total = _rd(os.path.join(card, "mem_info_vram_total"), "0")
        try:
            gb = f"{int(used) / 1e9:.1f}/{int(total) / 1e9:.1f} GB"
        except ValueError:
            gb = "?"
        print(f"  {os.path.basename(os.path.dirname(card)):8} busy {_rd(busy):>3}%   vram {gb}")
    if shutil.which("nvidia-smi"):   # NVIDIA cards are not in sysfs's AMD counters
        try:
            out = subprocess.run(["nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total",
                                  "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=10).stdout
            for ln in out.splitlines():
                name, busy, used, total = [x.strip() for x in ln.split(",")][:4]
                found = True
                print(f"  {name[:24]:24} busy {busy:>3}%   vram {float(used) / 1024:.1f}/{float(total) / 1024:.1f} GB")
        except (OSError, subprocess.SubprocessError, ValueError):
            pass
    if not found:
        print(dim("  no GPU found (Ollama runs on the CPU then: slower, but it works)"))
    return 0


QUICK_HELP = """gnoc chat - a local AI agent for code, security and your own machine.

  gnoc                      start a chat in the current folder (same as gnoc chat)
  gnoc chat [-p "task"]     start a chat; -p runs one task and exits. Inside: /help lists every command
  gnoc setup [--force]      the guided model setup: a model on this computer, or a cloud API key
  gnoc models [list|use <role> <model>]   the models gnoc uses (lead, worker) and the ones you have
  gnoc engine [install|start|stop|pull <model>|list|rm <model>|import-ollama]   gnoc's own model server:
                            pull takes owner/repo[:QUANT] from Hugging Face, a .gguf URL or a .gguf file
  gnoc gpus                 which model each role uses, whether it answers, and your GPUs
  gnoc pair <address> <key> use another computer's GPU: the line `gnoc-engine share on` printed there
                            (that computer needs only gnoc's engine, no Ollama)
  gnoc mcp [list|add|remove|tools|call]   MCP servers whose tools the chat can use
  gnoc phone [setup|up|down|pull <model>|models]   an Android phone on a USB cable as one more machine that
                            runs models (<model>@phone): gnoc phone setup walks through it
  gnoc link [add|test|list|remove]   (Linux) let the chat see and drive another Linux computer's desktop,
                            only after you approve each time
  gnoc update [--check]     download, verify and install the newest release
  gnoc update --auto on     install each new release by itself when gnoc starts (off turns it off)
  gnoc doctor               check this install: Python, its environment, the model, updates, config files
  gnoc gateway [check|run|install|status]   drive gnoc from Telegram, Slack, Signal or email: only your own
                            account, approvals asked in the same chat, secrets redacted (README: Messaging)
  gnoc schedule [list|run <id>]   the scheduled tasks set in the chat with /schedule add, and what each was saved
                            with; run <id> is what the timer runs (held approvals are reported, never run)
  gnoc privacy [local-only|web|image-lookup|updates|cloud on|off]   what can leave this computer, and the
                            switch for each (no telemetry, ever); local-only on: nothing leaves it
  gnoc export trajectories --format sharegpt|openai [--since YYYY-MM-DD] [--out PATH]   the chats' tool turns
                            as training data, redacted by default; nothing is uploaded
  gnoc export batch <prompts.jsonl> --out DIR [--workers N]   run prompts headless; anything that needs your
                            approval is held, never run
  gnoc help                 this list

  The README covers setup, settings (environment variables) and the defender.
"""


