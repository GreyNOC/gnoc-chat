    """The model assigned to a role with `gnoc models use <role> <model>` (.claude/state/orch/models.json)."""
    try:
        return json.loads(read(os.path.join(WS, ".claude/state/orch/models.json")) or "{}").get(role) or default
    except ValueError:
        return default


